<UserControl x:Class="TailoringShop.WPF.Views.Controls.PaginationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="50" d:DesignWidth="600">
    
    <Border Background="{StaticResource BackgroundBrush}"
            CornerRadius="8"
            Padding="15,10"
            Margin="0,15,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Info Text -->
            <StackPanel Grid.Column="0" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center">
                <TextBlock Text="عرض "
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13"/>
                <TextBlock x:Name="StartRecordText"
                           Text="1"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13"/>
                <TextBlock Text=" - "
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13"/>
                <TextBlock x:Name="EndRecordText"
                           Text="10"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontSize="13"/>
                <TextBlock Text=" من "
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13"/>
                <TextBlock x:Name="TotalRecordsText"
                           Text="100"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource PrimaryBrush}"
                           FontSize="13"/>
                <TextBlock Text=" سجل"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13"/>
            </StackPanel>

            <!-- Page Size Selector -->
            <StackPanel Grid.Column="1" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <TextBlock Text="عدد السجلات:"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>
                <ComboBox x:Name="PageSizeComboBox"
                          Width="70"
                          FontSize="13"
                          SelectedIndex="0"
                          SelectionChanged="PageSizeComboBox_SelectionChanged">
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="20"/>
                    <ComboBoxItem Content="50"/>
                    <ComboBoxItem Content="100"/>
                </ComboBox>
            </StackPanel>

            <!-- Navigation Buttons -->
            <StackPanel Grid.Column="2" 
                        Orientation="Horizontal" 
                        VerticalAlignment="Center">
                
                <!-- First Page -->
                <Button x:Name="FirstButton"
                        Style="{StaticResource IconButton}"
                        Content="⏮"
                        FontSize="14"
                        Width="36" Height="36"
                        ToolTip="الصفحة الأولى"
                        Click="FirstButton_Click"/>
                
                <!-- Previous Page -->
                <Button x:Name="PrevButton"
                        Style="{StaticResource IconButton}"
                        Content="◀"
                        FontSize="14"
                        Width="36" Height="36"
                        ToolTip="الصفحة السابقة"
                        Margin="5,0,0,0"
                        Click="PrevButton_Click"/>
                
                <!-- Page Info -->
                <Border Background="White"
                        CornerRadius="6"
                        Padding="15,8"
                        Margin="10,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="صفحة "
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="CurrentPageText"
                                   Text="1"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   FontSize="14"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" / "
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="TotalPagesText"
                                   Text="10"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- Next Page -->
                <Button x:Name="NextButton"
                        Style="{StaticResource IconButton}"
                        Content="▶"
                        FontSize="14"
                        Width="36" Height="36"
                        ToolTip="الصفحة التالية"
                        Click="NextButton_Click"/>
                
                <!-- Last Page -->
                <Button x:Name="LastButton"
                        Style="{StaticResource IconButton}"
                        Content="⏭"
                        FontSize="14"
                        Width="36" Height="36"
                        ToolTip="الصفحة الأخيرة"
                        Margin="5,0,0,0"
                        Click="LastButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
