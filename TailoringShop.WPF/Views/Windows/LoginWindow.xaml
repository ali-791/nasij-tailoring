<Window x:Class="TailoringShop.WPF.Views.Windows.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:TailoringShop.WPF.ViewModels"
        Title="تسجيل الدخول - نظام إدارة متجر الخياطة" 
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    
    <Border CornerRadius="20" Background="White">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Side - Gradient Background -->
            <Border Grid.Column="0" 
                    CornerRadius="20,0,0,20"
                    Background="{StaticResource PrimaryGradientBrush}">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <!-- Logo/Icon -->
                        <Border Width="100" Height="100" 
                                CornerRadius="50" 
                                Background="White" 
                                Opacity="0.2"
                                Margin="0,0,0,30"/>
                        
                        <TextBlock Text="نظام إدارة متجر الخياطة"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>
                        
                        <TextBlock Text="Tailoring Shop Management System"
                                   FontSize="14"
                                   Foreground="White"
                                   Opacity="0.8"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                        
                        <TextBlock Text="إدارة شاملة لمتجرك"
                                   FontSize="14"
                                   Foreground="White"
                                   Opacity="0.7"
                                   HorizontalAlignment="Center"
                                   Margin="0,30,0,0"/>
                    </StackPanel>

                    <!-- Decorative Circles -->
                    <Ellipse Width="200" Height="200" 
                             Fill="White" Opacity="0.05"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Margin="-50,-50,0,0"/>
                    <Ellipse Width="150" Height="150" 
                             Fill="White" Opacity="0.05"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-30,-30,0"/>
                </Grid>
            </Border>

            <!-- Right Side - Login Form -->
            <Grid Grid.Column="1" Margin="50">
                <!-- Close Button -->
                <Button Style="{StaticResource IconButton}"
                        Content="✕"
                        FontSize="18"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="CloseButton_Click"/>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="مرحباً بك"
                               FontSize="32"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Margin="0,0,0,10"/>
                    
                    <TextBlock Text="قم بتسجيل الدخول للمتابعة"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,40"/>

                    <!-- Username -->
                    <TextBlock Text="اسم المستخدم"
                               Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="UsernameTextBox"
                             Style="{StaticResource ModernTextBox}"
                             Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,20"/>

                    <!-- Password -->
                    <TextBlock Text="كلمة المرور"
                               Style="{StaticResource FormLabel}"/>
                    <PasswordBox x:Name="PasswordBox"
                                 Style="{StaticResource ModernPasswordBox}"
                                 Margin="0,0,0,10"/>

                    <!-- Error Message -->
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource DangerBrush}"
                               FontSize="13"
                               Margin="0,0,0,20"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <!-- Login Button -->
                    <Button Content="تسجيل الدخول"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding LoginCommand}"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}"
                            Height="50"
                            FontSize="16"
                            Margin="0,10,0,0"
                            Click="LoginButton_Click"/>

                    <!-- Loading Indicator -->
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="جاري تسجيل الدخول..."
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Footer -->
                <TextBlock Text="الإصدار 1.0.0"
                           FontSize="12"
                           Foreground="{StaticResource TextLightBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"/>
            </Grid>
        </Grid>
    </Border>
</Window>
