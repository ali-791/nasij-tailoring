<Window x:Class="TailoringShop.WPF.Views.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pages="clr-namespace:TailoringShop.WPF.Views.Pages"
        xmlns:vm="clr-namespace:TailoringShop.WPF.ViewModels"
        Title="نظام إدارة متجر الخياطة" 
        Height="800" Width="1400"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource BackgroundBrush}">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarGradientBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo Section -->
                <StackPanel Grid.Row="0" Margin="20,30,20,30">
                    <!-- Shop Logo (Circular) -->
                    <Grid Width="60" Height="60" 
                          HorizontalAlignment="Left"
                          Margin="0,0,0,15">
                        <!-- Default Logo Background (shown when no image) -->
                        <Border x:Name="DefaultLogoBorder"
                                Width="60" Height="60" 
                                CornerRadius="30" 
                                Background="{StaticResource PrimaryGradientBrush}">
                            <TextBlock x:Name="DefaultLogoText"
                                       Text="TS" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <!-- Shop Logo Image (shown when image exists) -->
                        <Border x:Name="ShopLogoBorder"
                                Width="60" Height="60" 
                                CornerRadius="30"
                                Visibility="Collapsed">
                            <Border.Clip>
                                <EllipseGeometry Center="30,30" RadiusX="30" RadiusY="30"/>
                            </Border.Clip>
                            <Image x:Name="ShopLogoImage" 
                                   Stretch="UniformToFill"/>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="ShopNameText"
                               Text="متجر الخياطة"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="White"/>
                    <TextBlock Text="نظام الإدارة الشامل"
                               FontSize="12"
                               Foreground="{StaticResource TextLightBrush}"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Navigation Menu -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10">
                        <!-- Dashboard -->
                        <Button Style="{StaticResource SidebarMenuButton}"
                                Command="{Binding NavigateToDashboardCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📊" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="لوحة التحكم" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Separator -->
                        <TextBlock Text="المبيعات" 
                                   FontSize="11" 
                                   Foreground="{StaticResource TextLightBrush}"
                                   Margin="20,20,20,10"
                                   Opacity="0.6"/>

                        <!-- Tailoring Orders -->
                        <Button Style="{StaticResource SidebarMenuButton}"
                                Command="{Binding NavigateToTailoringOrdersCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✂️" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="طلبات الفصال" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Invoices -->
                        <Button Style="{StaticResource SidebarMenuButton}"
                                Command="{Binding NavigateToInvoicesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🧾" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="الفواتير" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Customers -->
                        <Button Style="{StaticResource SidebarMenuButton}"
                                Command="{Binding NavigateToCustomersCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👥" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="العملاء" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Separator -->
                        <TextBlock Text="المخزون" 
                                   FontSize="11" 
                                   Foreground="{StaticResource TextLightBrush}"
                                   Margin="20,20,20,10"
                                   Opacity="0.6"/>

                        <!-- Products -->
                        <Button Style="{StaticResource SidebarMenuButton}"
                                Command="{Binding NavigateToProductsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📦" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="المنتجات" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Separator -->
                        <TextBlock Text="المالية" 
                                   FontSize="11" 
                                   Foreground="{StaticResource TextLightBrush}"
                                   Margin="20,20,20,10"
                                   Opacity="0.6"/>

                        <!-- Cashboxes -->
                        <Button Style="{StaticResource SidebarMenuButton}"
                                Command="{Binding NavigateToCashboxesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💰" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="القاصات" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Expenses -->
                        <Button Style="{StaticResource SidebarMenuButton}"
                                Command="{Binding NavigateToExpensesCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💸" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="المصروفات" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Reports -->
                        <Button Style="{StaticResource SidebarMenuButton}"
                                Command="{Binding NavigateToReportsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📈" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="التقارير" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Separator -->
                        <TextBlock Text="النظام" 
                                   FontSize="11" 
                                   Foreground="{StaticResource TextLightBrush}"
                                   Margin="20,20,20,10"
                                   Opacity="0.6"/>

                        <!-- Settings -->
                        <Button Style="{StaticResource SidebarMenuButton}"
                                Command="{Binding NavigateToSettingsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙️" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="الإعدادات" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Invoice Settings -->
                        <Button Style="{StaticResource SidebarMenuButton}"
                                Command="{Binding NavigateToInvoiceSettingsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖨️" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="تخصيص الفاتورة" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Users -->
                        <Button Style="{StaticResource SidebarMenuButton}"
                                Command="{Binding NavigateToUsersCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👤" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="المستخدمين" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>

                <!-- User Section -->
                <Border Grid.Row="2" 
                        Background="#2d2d44" 
                        Padding="15"
                        Margin="10,10,10,15"
                        CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar -->
                        <Border Grid.Column="0" 
                                Width="40" Height="40" 
                                CornerRadius="20"
                                Background="{StaticResource PrimaryBrush}">
                            <TextBlock Text="👤" 
                                       FontSize="18"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <!-- User Info -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentUser.FullName, FallbackValue='مدير النظام'}"
                                       Foreground="White"
                                       FontWeight="SemiBold"
                                       FontSize="13"/>
                            <TextBlock Text="{Binding CurrentUser.Username, FallbackValue='admin'}"
                                       Foreground="{StaticResource TextLightBrush}"
                                       FontSize="11"/>
                        </StackPanel>

                        <!-- Logout Button -->
                        <Button Grid.Column="2"
                                Style="{StaticResource IconButton}"
                                Content="🚪"
                                FontSize="16"
                                ToolTip="تسجيل الخروج"
                                Command="{Binding LogoutCommand}"
                                Click="LogoutButton_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" 
                    Background="White"
                    Padding="30,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Page Title -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPageTitle}"
                                   Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="{Binding Source={x:Static sys:DateTime.Today}, StringFormat='dddd، d MMMM yyyy', ConverterCulture='ar-IQ'}"
                                   xmlns:sys="clr-namespace:System;assembly=mscorlib"
                                   Style="{StaticResource BodyText}"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Header Actions -->
                    <StackPanel Grid.Column="1" 
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <!-- Search Box -->
                        <Border Background="{StaticResource BackgroundBrush}"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,0,15,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔍" 
                                           FontSize="14" 
                                           Margin="0,0,8,0"
                                           VerticalAlignment="Center"/>
                                <TextBox Background="Transparent"
                                         BorderThickness="0"
                                         Width="200"
                                         FontSize="13"
                                         VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Notifications -->
                        <Button Style="{StaticResource IconButton}"
                                Content="🔔"
                                FontSize="18"
                                Margin="0,0,10,0"/>

                        <!-- Refresh -->
                        <Button Style="{StaticResource IconButton}"
                                Content="🔄"
                                FontSize="18"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Page Content -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ContentControl Content="{Binding CurrentPage}" Margin="30"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
