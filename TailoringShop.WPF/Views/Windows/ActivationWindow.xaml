<Window x:Class="TailoringShop.WPF.Views.Windows.ActivationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تفعيل البرنامج"
        Height="350" Width="450"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="#f0f4f8">
    
    <Border Background="White" CornerRadius="15" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.15"/>
        </Border.Effect>
        
        <StackPanel VerticalAlignment="Center" Margin="40">
            
            <!-- Icon -->
            <Border Width="70" Height="70" 
                    CornerRadius="35" 
                    Background="#6366f1" 
                    HorizontalAlignment="Center"
                    Margin="0,0,0,20">
                <TextBlock Text="🔐" 
                           FontSize="30" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
            </Border>
            
            <!-- Title -->
            <TextBlock Text="أدخل مفتاح التفعيل" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Foreground="#1e293b"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,25"/>
            
            <!-- License Key Input -->
            <TextBox x:Name="LicenseKeyInput"
                     FontSize="15"
                     FontFamily="Consolas"
                     Padding="15"
                     CharacterCasing="Upper"
                     MaxLength="50"
                     TextAlignment="Center"
                     Background="#f8fafc"
                     BorderBrush="#e2e8f0"
                     BorderThickness="2">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="10"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>
            
            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Margin="0,25,0,0">
                
                <Button Content="تفعيل"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Padding="35,12"
                        Margin="0,0,10,0"
                        Background="#6366f1"
                        Foreground="White"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="Activate_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
                
                <Button Content="إغلاق"
                        FontSize="14"
                        Padding="35,12"
                        Background="#e2e8f0"
                        Foreground="#475569"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CloseButton_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
            
        </StackPanel>
    </Border>
</Window>
