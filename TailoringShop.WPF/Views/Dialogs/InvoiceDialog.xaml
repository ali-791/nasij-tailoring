<Window x:Class="TailoringShop.WPF.Views.Dialogs.InvoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="فاتورة بيع"
        Height="700" Width="900"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    
    <Border CornerRadius="16" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="5" Direction="270" Color="#000000" Opacity="0.15"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" 
                    Background="{StaticResource SuccessGradientBrush}"
                    CornerRadius="16,16,0,0"
                    Padding="24,20">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="TitleText"
                                   Text="فاتورة بيع جديدة"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="أضف المنتجات للفاتورة"
                                   FontSize="13"
                                   Foreground="White"
                                   Opacity="0.8"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource IconButton}"
                                Content="🗖"
                                FontSize="14"
                                Foreground="White"
                                Margin="0,0,5,0"
                                Click="MaximizeButton_Click"/>
                        <Button Style="{StaticResource IconButton}"
                                Content="✕"
                                FontSize="16"
                                Foreground="White"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Form Content -->
            <Grid Grid.Row="1" Margin="24,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- Left Side - Items -->
                <Grid Grid.Column="0" Margin="0,0,20,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Customer & Cashbox Selection -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="العميل"
                                       Style="{StaticResource FormLabel}"/>
                            <ComboBox x:Name="CustomerComboBox"
                                      DisplayMemberPath="FullName"
                                      IsEditable="True"
                                      Padding="10,8"
                                      FontSize="13"/>
                        </StackPanel>

                        <!-- Cashbox Selection -->
                        <StackPanel Grid.Column="1" Margin="0,0,15,0">
                            <TextBlock Text="الصندوق *"
                                       Style="{StaticResource FormLabel}"
                                       Foreground="#d32f2f"/>
                            <ComboBox x:Name="CashboxComboBox"
                                      DisplayMemberPath="Name"
                                      Padding="10,8"
                                      FontSize="13"
                                      SelectionChanged="CashboxComboBox_SelectionChanged"/>
                        </StackPanel>

                        <!-- Date -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="التاريخ"
                                       Style="{StaticResource FormLabel}"/>
                            <DatePicker x:Name="InvoiceDatePicker"
                                        Padding="10,8"
                                        FontSize="13"/>
                        </StackPanel>
                    </Grid>

                    <!-- Add Product Row -->
                    <Border Grid.Row="1" 
                            Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="ProductComboBox"
                                      Grid.Column="0"
                                      DisplayMemberPath="Name"
                                      IsEditable="True"
                                      Padding="8,6"
                                      FontSize="13"
                                      Margin="0,0,10,0"
                                      SelectionChanged="ProductComboBox_SelectionChanged"/>

                            <TextBox x:Name="QuantityTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource ModernTextBox}"
                                     Text="1"
                                     FontSize="13"
                                     Margin="0,0,10,0"
                                     VerticalContentAlignment="Center"/>

                            <TextBox x:Name="PriceTextBox"
                                     Grid.Column="2"
                                     Style="{StaticResource ModernTextBox}"
                                     Text="0"
                                     FontSize="13"
                                     Margin="0,0,10,0"
                                     VerticalContentAlignment="Center"/>

                            <Button Grid.Column="3"
                                    Style="{StaticResource PrimaryButton}"
                                    Content="➕ إضافة"
                                    Padding="15,8"
                                    FontSize="12"
                                    Click="AddProductButton_Click"/>
                        </Grid>
                    </Border>

                    <!-- Items List -->
                    <Border Grid.Row="2" 
                            Background="{StaticResource BackgroundBrush}"
                            CornerRadius="8"
                            Padding="5">
                        <DataGrid x:Name="ItemsDataGrid"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="None"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  RowBackground="White"
                                  AlternatingRowBackground="#fafafa"
                                  FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="60" IsReadOnly="True"/>
                                <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, StringFormat=N0}" Width="80" IsReadOnly="True"/>
                                <DataGridTextColumn Header="المجموع" Binding="{Binding Total, StringFormat=N0}" Width="90" IsReadOnly="True"/>
                                <DataGridTemplateColumn Header="" Width="40">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource IconButton}"
                                                    Content="🗑️"
                                                    Width="28" Height="28"
                                                    Click="RemoveItemButton_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>

                <!-- Right Side - Summary -->
                <Border Grid.Column="1"
                        Background="{StaticResource BackgroundBrush}"
                        CornerRadius="12"
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="ملخص الفاتورة"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   Margin="0,0,0,20"/>

                        <!-- Subtotal -->
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="المجموع الفرعي:"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock x:Name="SubtotalText"
                                       Text="0 د.ع"
                                       HorizontalAlignment="Right"
                                       FontWeight="SemiBold"/>
                        </Grid>

                        <!-- Discount -->
                        <Border Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="الخصم"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DiscountTextBox"
                                             Text="0"
                                             Padding="8,6"
                                             FontSize="13"
                                             TextChanged="DiscountTextBox_TextChanged"/>
                                    <ComboBox x:Name="DiscountTypeComboBox"
                                              Grid.Column="1"
                                              SelectedIndex="0"
                                              Padding="5,6"
                                              FontSize="12"
                                              Margin="8,0,0,0"
                                              SelectionChanged="DiscountTypeComboBox_SelectionChanged">
                                        <ComboBoxItem Content="د.ع"/>
                                        <ComboBoxItem Content="%"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Total -->
                        <Border Background="{StaticResource SuccessBrush}" 
                                CornerRadius="8" 
                                Padding="15"
                                Margin="0,0,0,20">
                            <Grid>
                                <TextBlock Text="الإجمالي:"
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="14"/>
                                <TextBlock x:Name="TotalText"
                                           Text="0 د.ع"
                                           HorizontalAlignment="Right"
                                           Foreground="White"
                                           FontWeight="Bold"
                                           FontSize="18"/>
                            </Grid>
                        </Border>

                        <!-- Payment -->
                        <TextBlock Text="الدفع"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,10"/>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="المبلغ المدفوع"
                                       Style="{StaticResource FormLabel}"
                                       FontSize="12"/>
                            <TextBox x:Name="PaidAmountTextBox"
                                     Text="0"
                                     Padding="10,8"
                                     FontSize="13"
                                     TextChanged="PaidAmountTextBox_TextChanged"/>
                        </StackPanel>

                        <!-- Remaining -->
                        <Grid Margin="0,0,0,15">
                            <TextBlock Text="المتبقي:"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource DangerBrush}"/>
                            <TextBlock x:Name="RemainingText"
                                       Text="0 د.ع"
                                       HorizontalAlignment="Right"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}"/>
                        </Grid>

                        <!-- Notes -->
                        <StackPanel>
                            <TextBlock Text="ملاحظات"
                                       Style="{StaticResource FormLabel}"
                                       FontSize="12"/>
                            <TextBox x:Name="NotesTextBox"
                                     Height="60"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     Padding="10,8"
                                     FontSize="12"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Footer Buttons -->
            <Border Grid.Row="2" 
                    BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               x:Name="ItemsCountText"
                               Text="0 منتج"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Style="{StaticResource OutlineButton}"
                            Content="إلغاء"
                            Padding="25,10"
                            Margin="0,0,10,0"
                            Click="CancelButton_Click"/>

                    <Button Grid.Column="2"
                            Style="{StaticResource SuccessButton}"
                            Content="💾 حفظ"
                            Padding="25,10"
                            Margin="0,0,10,0"
                            Click="SaveButton_Click"/>
                    
                    <Button Grid.Column="3"
                            Style="{StaticResource PrimaryButton}"
                            Content="🖨️ حفظ وطباعة"
                            Padding="25,10"
                            Click="SaveAndPrintButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
