<Window x:Class="TailoringShop.WPF.Views.Dialogs.RolePermissionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة الأدوار والصلاحيات" Height="650" Width="900"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}" FlowDirection="RightToLeft">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Roles List -->
        <Border Grid.Column="0" Style="{StaticResource DashboardCard}" Margin="0,0,15,0" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="الأدوار" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                <ListBox x:Name="RolesListBox" Grid.Row="1" BorderThickness="0" Background="Transparent"
                         SelectionChanged="RolesListBox_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" Margin="0,2" CornerRadius="8" Background="#f5f5f5">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Permissions Panel -->
        <Border Grid.Column="1" Style="{StaticResource DashboardCard}" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,15">
                    <TextBlock x:Name="SelectedRoleTitle" Text="اختر دور لعرض صلاحياته" FontSize="18" FontWeight="Bold"/>
                    <TextBlock x:Name="SelectedRoleDesc" Text="" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ModulesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#e0e0e0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ModuleDisplayName}" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                                        <ItemsControl ItemsSource="{Binding Permissions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding DisplayName}" IsChecked="{Binding IsGranted, Mode=TwoWay}"
                                                              Margin="0,5,20,5" FontSize="13" Checked="Permission_Changed" Unchecked="Permission_Changed"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,15,0,0">
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="💾 حفظ الصلاحيات" Padding="20,10" Click="Save_Click" IsEnabled="False"/>
                    <Button Style="{StaticResource SecondaryButton}" Content="إغلاق" Padding="20,10" Margin="10,0,0,0" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
