<Window x:Class="TailoringShop.WPF.Views.Dialogs.UserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة المستخدم" Height="520" Width="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}" FlowDirection="RightToLeft">
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,25">
            <StackPanel Orientation="Horizontal">
                <Border Width="50" Height="50" CornerRadius="12" Background="{StaticResource PrimaryGradientBrush}">
                    <TextBlock Text="👤" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="15,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="DialogTitle" Text="إضافة مستخدم جديد" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="أدخل بيانات المستخدم" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!-- Form -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="اسم المستخدم *" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="UsernameTextBox" Style="{StaticResource ModernTextBox}" FontSize="14"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="الاسم الكامل *" Style="{StaticResource FormLabel}"/>
                    <TextBox x:Name="FullNameTextBox" Style="{StaticResource ModernTextBox}" FontSize="14"/>
                </StackPanel>
                <StackPanel x:Name="PasswordPanel" Margin="0,0,0,15">
                    <TextBlock Text="كلمة المرور *" Style="{StaticResource FormLabel}"/>
                    <PasswordBox x:Name="PasswordBox" Padding="12,10" FontSize="14"/>
                </StackPanel>
                <StackPanel x:Name="ConfirmPasswordPanel" Margin="0,0,0,15">
                    <TextBlock Text="تأكيد كلمة المرور *" Style="{StaticResource FormLabel}"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" Padding="12,10" FontSize="14"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,15">
                    <TextBlock Text="الدور *" Style="{StaticResource FormLabel}"/>
                    <ComboBox x:Name="RoleComboBox" Padding="12,10" FontSize="14" DisplayMemberPath="DisplayName"/>
                </StackPanel>
                <StackPanel Margin="0,0,0,15">
                    <CheckBox x:Name="IsActiveCheckBox" Content="حساب نشط" IsChecked="True" FontSize="14"/>
                </StackPanel>
                <Border Background="#fff8e1" CornerRadius="8" Padding="15" Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💡" FontSize="18" Margin="0,0,10,0"/>
                        <TextBlock Text="صلاحيات المستخدم تعتمد على الدور المختار. لتعديل الصلاحيات، استخدم 'إدارة الأدوار'"
                                   TextWrapping="Wrap" FontSize="12" Foreground="#f57c00"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="إلغاء" Margin="0,0,10,0" Click="Cancel_Click"/>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="💾 حفظ" Margin="10,0,0,0" Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>
