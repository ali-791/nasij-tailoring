<Window x:Class="TailoringShop.WPF.Views.Dialogs.CustomerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        Height="400" Width="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    
    <Border CornerRadius="16" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="5" Direction="270" Color="#000000" Opacity="0.15"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" 
                    Background="{StaticResource PrimaryGradientBrush}"
                    CornerRadius="16,16,0,0"
                    Padding="24,20">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="TitleText"
                                   Text="إضافة عميل جديد"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="أدخل بيانات العميل"
                                   FontSize="13"
                                   Foreground="White"
                                   Opacity="0.8"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource IconButton}"
                                Content="🗖"
                                FontSize="14"
                                Foreground="White"
                                Margin="0,0,5,0"
                                Click="MaximizeButton_Click"/>
                        <Button Style="{StaticResource IconButton}"
                                Content="✕"
                                FontSize="16"
                                Foreground="White"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,20">
                <StackPanel>
                    <!-- Full Name -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="اسم العميل *"
                                   Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="FullNameTextBox"
                                 Style="{StaticResource ModernTextBox}"
                                 MaxLength="100"/>
                        <TextBlock x:Name="FullNameError"
                                   Text="اسم العميل مطلوب"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Phone -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="رقم الهاتف *"
                                   Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="PhoneTextBox"
                                 Style="{StaticResource ModernTextBox}"
                                 MaxLength="20"/>
                        <TextBlock x:Name="PhoneError"
                                   Text="رقم الهاتف مطلوب"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="12"
                                   Margin="0,5,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <!-- Is Active -->
                    <StackPanel Margin="0,0,0,10">
                        <CheckBox x:Name="IsActiveCheckBox"
                                  Content="عميل نشط"
                                  IsChecked="True"
                                  FontSize="14"
                                  Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Buttons -->
            <Border Grid.Row="2" 
                    BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Required Fields Note -->
                    <TextBlock Grid.Column="0"
                               Text="* حقول مطلوبة"
                               FontSize="12"
                               Foreground="{StaticResource TextLightBrush}"
                               VerticalAlignment="Center"/>

                    <!-- Cancel Button -->
                    <Button Grid.Column="1"
                            Style="{StaticResource OutlineButton}"
                            Content="إلغاء"
                            Padding="25,10"
                            Margin="0,0,10,0"
                            Click="CancelButton_Click"/>

                    <!-- Save Button -->
                    <Button Grid.Column="2"
                            Style="{StaticResource PrimaryButton}"
                            Content="💾 حفظ"
                            Padding="25,10"
                            Click="SaveButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
