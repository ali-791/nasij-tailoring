<Window x:Class="TailoringShop.WPF.Views.Dialogs.CashboxDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="صندوق"
        Height="380" Width="450"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False">
    
    <Border CornerRadius="16" Background="White">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="5" Direction="270" Color="#000000" Opacity="0.15"/>
        </Border.Effect>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" 
                    Background="{StaticResource PrimaryGradientBrush}"
                    CornerRadius="16,16,0,0"
                    Padding="24,20">
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="TitleText"
                                   Text="إضافة صندوق جديد"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="إدارة الصناديق المالية"
                                   FontSize="13"
                                   Foreground="White"
                                   Opacity="0.8"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                        <Button Style="{StaticResource IconButton}"
                                Content="🗖"
                                FontSize="14"
                                Foreground="White"
                                Margin="0,0,5,0"
                                Click="MaximizeButton_Click"/>
                        <Button Style="{StaticResource IconButton}"
                                Content="✕"
                                FontSize="16"
                                Foreground="White"
                                Click="CloseButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          Padding="24,20">
                <StackPanel>
                    <!-- Name -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="اسم الصندوق *"
                                   Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="NameTextBox"
                                 Style="{StaticResource ModernTextBox}"/>
                        <TextBlock x:Name="NameError"
                                   Text="يرجى إدخال اسم الصندوق"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="11"
                                   Visibility="Collapsed"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Type -->
                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="نوع الصندوق"
                                   Style="{StaticResource FormLabel}"/>
                        <ComboBox x:Name="TypeComboBox"
                                  Padding="12,10"
                                  FontSize="14">
                            <ComboBoxItem Content="صندوق عام" Tag="General"/>
                            <ComboBoxItem Content="صندوق الفصال" Tag="Tailoring"/>
                            <ComboBoxItem Content="صندوق الملابس الجاهزة" Tag="ReadyMade"/>
                            <ComboBoxItem Content="صندوق العطور" Tag="Perfumes"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- Initial Balance (only for new) -->
                    <StackPanel x:Name="InitialBalancePanel" Margin="0,0,0,15">
                        <TextBlock Text="الرصيد الافتتاحي"
                                   Style="{StaticResource FormLabel}"/>
                        <TextBox x:Name="InitialBalanceTextBox"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer Buttons -->
            <Border Grid.Row="2" 
                    BorderThickness="0,1,0,0"
                    BorderBrush="{StaticResource BorderLightBrush}"
                    Padding="24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1"
                            Style="{StaticResource OutlineButton}"
                            Content="إلغاء"
                            Padding="25,10"
                            Margin="0,0,10,0"
                            Click="CancelButton_Click"/>

                    <Button Grid.Column="2"
                            Style="{StaticResource PrimaryButton}"
                            Content="💾 حفظ"
                            Padding="30,10"
                            Click="SaveButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
