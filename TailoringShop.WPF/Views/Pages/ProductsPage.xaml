<UserControl x:Class="TailoringShop.WPF.Views.Pages.ProductsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:TailoringShop.WPF.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Stats Cards -->
        <UniformGrid Grid.Row="0" Rows="1" Columns="3" Margin="0,0,0,20">
            <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="إجمالي المنتجات" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding TotalProducts}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,10,0,0"/>
                    </StackPanel>
                    <TextBlock Text="📦" FontSize="40" Opacity="0.1" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="منتجات نشطة" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding ActiveProducts}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource SuccessBrush}" Margin="0,10,0,0"/>
                    </StackPanel>
                    <TextBlock Text="✓" FontSize="40" Opacity="0.1" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardCard}" Margin="0"
                    Background="{StaticResource InfoGradientBrush}" Cursor="Hand"
                    MouseLeftButtonUp="AddPurchaseInvoice_Click">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="🧾" FontSize="32" HorizontalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="فاتورة شراء جديدة" FontSize="14" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Search Bar -->
        <Border Grid.Row="1" Style="{StaticResource DashboardCard}" Margin="0,0,0,20" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource BackgroundBrush}" CornerRadius="8"
                        Padding="12,8" MaxWidth="400" HorizontalAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.5"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" FontSize="14" VerticalAlignment="Center" Width="280"/>
                        <TextBlock Grid.Column="1" Text="بحث بالاسم أو الباركود..." FontSize="14"
                                   Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=inverse}"/>
                    </Grid>
                </Border>

                <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="Name" Width="200" Margin="15,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Content="🔄 تحديث" Command="{Binding RefreshCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource DashboardCard}" Padding="0">
            <Grid>
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="جاري التحميل..." FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <DataGrid x:Name="ProductsDataGrid"
                          ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct}"
                          Style="{StaticResource ModernDataGrid}"
                          RowStyle="{StaticResource ModernDataGridRow}"
                          CellStyle="{StaticResource ModernDataGridCell}"
                          ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}"
                          RowDetailsVisibilityMode="VisibleWhenSelected"
                          MouseDoubleClick="DataGrid_MouseDoubleClick"
                          PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown">
                    
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AnimatedRowDetails}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource DetailCard}">
                                        <StackPanel>
                                            <TextBlock Text="📦 معلومات المنتج" Style="{StaticResource DetailSectionHeader}"/>
                                            <TextBlock Text="اسم المنتج" Style="{StaticResource DetailLabel}"/>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource DetailValue}"/>
                                            <TextBlock Text="الرمز (SKU)" Style="{StaticResource DetailLabel}" Margin="0,10,0,4"/>
                                            <TextBlock Text="{Binding SKU, TargetNullValue='-'}" Style="{StaticResource DetailValue}" 
                                                       Foreground="{StaticResource InfoBrush}"/>
                                            <TextBlock Text="الباركود" Style="{StaticResource DetailLabel}" Margin="0,10,0,4"/>
                                            <TextBlock Text="{Binding Barcode, TargetNullValue='-'}" Style="{StaticResource DetailValue}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Style="{StaticResource DetailCard}">
                                        <StackPanel>
                                            <TextBlock Text="💰 الأسعار" Style="{StaticResource DetailSectionHeader}"/>
                                            <TextBlock Text="سعر الشراء" Style="{StaticResource DetailLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding CostPrice, StringFormat=N0}" 
                                                           Style="{StaticResource DetailValue}" Foreground="{StaticResource DangerBrush}"/>
                                                <TextBlock Text=" د.ع" Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                            </StackPanel>
                                            <TextBlock Text="سعر البيع" Style="{StaticResource DetailLabel}" Margin="0,10,0,4"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding SellingPrice, StringFormat=N0}" Style="{StaticResource DetailValueCurrency}"/>
                                                <TextBlock Text=" د.ع" Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource DetailCard}">
                                        <StackPanel>
                                            <TextBlock Text="📊 المخزون" Style="{StaticResource DetailSectionHeader}"/>
                                            <TextBlock Text="الكمية المتوفرة" Style="{StaticResource DetailLabel}"/>
                                            <TextBlock Text="{Binding Inventories, Converter={StaticResource StockQuantityConverter}}" 
                                                       Style="{StaticResource DetailValue}"
                                                       Foreground="{Binding Inventories, Converter={StaticResource StockToForegroundConverter}}"/>
                                            <TextBlock Text="الحد الأدنى" Style="{StaticResource DetailLabel}" Margin="0,10,0,4"/>
                                            <TextBlock Text="{Binding MinStockLevel}" Style="{StaticResource DetailValue}"/>
                                            <TextBlock Text="الوحدة" Style="{StaticResource DetailLabel}" Margin="0,10,0,4"/>
                                            <TextBlock Text="{Binding Unit}" Style="{StaticResource DetailValue}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="3" Style="{StaticResource DetailCard}" Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="⚙️ الإعدادات" Style="{StaticResource DetailSectionHeader}"/>
                                            <TextBlock Text="التصنيف" Style="{StaticResource DetailLabel}"/>
                                            <TextBlock Text="{Binding Category.Name, TargetNullValue='بدون تصنيف'}" Style="{StaticResource DetailValue}"/>
                                            <TextBlock Text="الحالة" Style="{StaticResource DetailLabel}" Margin="0,10,0,4"/>
                                            <Border CornerRadius="12" Padding="12,6" HorizontalAlignment="Right"
                                                    Background="{Binding IsActive, Converter={StaticResource BoolToBackgroundConverter}}">
                                                <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}"
                                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToForegroundConverter}}"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                    
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="▶" FontSize="10" Foreground="{StaticResource TextLightBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                        <Setter Property="Text" Value="▼"/>
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="60" IsReadOnly="True"/>
                        <DataGridTextColumn Header="اسم المنتج" Binding="{Binding Name}" Width="*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="120" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="سعر البيع" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding SellingPrice, StringFormat=N0}"/>
                                        <Run Text=" د.ع" Foreground="{StaticResource TextLightBrush}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="المخزون" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left"
                                            Background="{Binding Inventories, Converter={StaticResource StockToBackgroundConverter}}">
                                        <TextBlock Text="{Binding Inventories, Converter={StaticResource StockQuantityConverter}}"
                                                   FontSize="12" Foreground="{Binding Inventories, Converter={StaticResource StockToForegroundConverter}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="التصنيف" Binding="{Binding Category.Name}" Width="120" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="إجراءات" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Content="✏️" ToolTip="تعديل"
                                                Click="EditButton_Click" Width="35" Height="35"/>
                                        <Button Style="{StaticResource IconButton}" Content="🗑️" ToolTip="حذف"
                                                Click="DeleteButton_Click" Width="35" Height="35"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Visibility="{Binding Products.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=inverse}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📦" FontSize="64" HorizontalAlignment="Center" Opacity="0.3"/>
                    <TextBlock Text="لا يوجد منتجات" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <TextBlock Text="قم بإضافة منتجات من خلال فاتورة شراء" FontSize="14" Foreground="{StaticResource TextLightBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Pagination -->
        <controls:PaginationControl Grid.Row="3"
                                    CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
                                    TotalPages="{Binding TotalPages}"
                                    TotalRecords="{Binding TotalRecords}"
                                    PageSize="{Binding PageSize, Mode=TwoWay}"
                                    PageChangedCommand="{Binding PageChangedCommand}"/>
    </Grid>
</UserControl>
