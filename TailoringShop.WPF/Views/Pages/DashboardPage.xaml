<UserControl x:Class="TailoringShop.WPF.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:TailoringShop.WPF.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Stats Cards Row 1 -->
        <UniformGrid Grid.Row="0" Rows="1" Margin="0,0,0,20">
            <!-- Total Sales Today -->
            <Border Style="{StaticResource PrimaryStatCard}" Margin="0,0,15,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="مبيعات اليوم"
                                   Foreground="White"
                                   Opacity="0.9"
                                   FontSize="14"/>
                        <TextBlock Text="{Binding TotalSalesToday, StringFormat=N0}"
                                   Style="{StaticResource StatValueWhite}"
                                   Margin="0,10,0,0"/>
                        <TextBlock Text="د.ع"
                                   Foreground="White"
                                   Opacity="0.7"
                                   FontSize="12"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                    <TextBlock Text="💵"
                               FontSize="40"
                               Opacity="0.2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- Sales Count -->
            <Border Style="{StaticResource SuccessStatCard}" Margin="0,0,15,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="عدد الفواتير"
                                   Foreground="White"
                                   Opacity="0.9"
                                   FontSize="14"/>
                        <TextBlock Text="{Binding SalesCountToday}"
                                   Style="{StaticResource StatValueWhite}"
                                   Margin="0,10,0,0"/>
                        <TextBlock Text="فاتورة اليوم"
                                   Foreground="White"
                                   Opacity="0.7"
                                   FontSize="12"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                    <TextBlock Text="🧾"
                               FontSize="40"
                               Opacity="0.2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- Total Expenses -->
            <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="مصروفات اليوم"
                                   Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding TotalExpensesToday, StringFormat=N0}"
                                   Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource DangerBrush}"
                                   Margin="0,10,0,0"/>
                        <TextBlock Text="د.ع"
                                   Foreground="{StaticResource TextLightBrush}"
                                   FontSize="12"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                    <TextBlock Text="💸"
                               FontSize="40"
                               Opacity="0.1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- Gross Profit (إجمالي الربح) -->
            <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="إجمالي الربح"
                                   Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding GrossProfitToday, StringFormat=N0}"
                                   Style="{StaticResource StatValue}"
                                   Foreground="#2196F3"
                                   Margin="0,10,0,0"/>
                        <TextBlock Text="(المبيعات - تكلفة البضائع)"
                                   Foreground="{StaticResource TextLightBrush}"
                                   FontSize="10"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                    <TextBlock Text="💰"
                               FontSize="40"
                               Opacity="0.1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- Net Profit (صافي الربح) -->
            <Border Style="{StaticResource DashboardCard}">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="صافي الربح"
                                   Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding NetProfitToday, StringFormat=N0}"
                                   Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource SuccessBrush}"
                                   Margin="0,10,0,0"/>
                        <TextBlock Text="(الربح - المصروفات)"
                                   Foreground="{StaticResource TextLightBrush}"
                                   FontSize="10"
                                   Margin="0,5,0,0"/>
                    </StackPanel>
                    <TextBlock Text="📈"
                               FontSize="40"
                               Opacity="0.1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"/>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Orders Status Row -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tailoring Orders Status -->
            <Border Grid.Column="0" Style="{StaticResource DashboardCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="حالة طلبات الفصال"
                               Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,20"/>
                    
                    <UniformGrid Rows="1">
                        <!-- New Orders -->
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="60" Height="60" 
                                    CornerRadius="30"
                                    Background="#fff3e0">
                                <TextBlock Text="{Binding PendingOrders}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#f57c00"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="جديد"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <!-- In Progress -->
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="60" Height="60" 
                                    CornerRadius="30"
                                    Background="#e3f2fd">
                                <TextBlock Text="{Binding InProgressOrders}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#1976d2"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="قيد التنفيذ"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <!-- Ready -->
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="60" Height="60" 
                                    CornerRadius="30"
                                    Background="#e8f5e9">
                                <TextBlock Text="{Binding ReadyOrders}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="#388e3c"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="جاهز"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Alerts -->
            <Border Grid.Column="1" Style="{StaticResource DashboardCard}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="تنبيهات"
                               Style="{StaticResource SectionTitle}"
                               Margin="0,0,0,20"/>

                    <!-- Low Stock Alert -->
                    <Border Background="#fff5f5" 
                            CornerRadius="10" 
                            Padding="15"
                            Margin="0,0,0,10"
                            Visibility="{Binding LowStockProducts, Converter={StaticResource IntToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" 
                                    Width="40" Height="40" 
                                    CornerRadius="10"
                                    Background="{StaticResource DangerBrush}">
                                <TextBlock Text="⚠️" 
                                           FontSize="18"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            
                            <StackPanel Grid.Column="1" Margin="15,0">
                                <TextBlock Text="مخزون منخفض"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource DangerBrush}"/>
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12">
                                    <Run Text="{Binding LowStockProducts, Mode=OneWay}"/>
                                    <Run Text="منتج بحاجة لإعادة تعبئة"/>
                                </TextBlock>
                            </StackPanel>
                            
                            <Button Grid.Column="2"
                                    Content="عرض"
                                    Style="{StaticResource OutlineButton}"
                                    Padding="15,8"
                                    FontSize="12"/>
                        </Grid>
                    </Border>

                    <!-- No Alerts -->
                    <TextBlock Text="✅ لا توجد تنبيهات"
                               Foreground="{StaticResource SuccessBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="0,20"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Cashboxes Summary -->
        <Border Grid.Row="2" Style="{StaticResource DashboardCard}">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <TextBlock Text="ملخص القاصات"
                               Style="{StaticResource SectionTitle}"/>
                    <Button Content="🔄 تحديث"
                            Style="{StaticResource OutlineButton}"
                            HorizontalAlignment="Right"
                            Padding="15,8"
                            FontSize="12"
                            Command="{Binding RefreshCommand}"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding CashboxSummaries}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BackgroundBrush}"
                                    CornerRadius="12"
                                    Padding="20"
                                    Margin="0,0,15,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Margin="0,0,0,10"/>
                                    
                                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}">
                                        <Run Text="{Binding CurrentBalance, StringFormat=N0}"/>
                                        <Run Text="{Binding CurrencySymbol}" FontSize="14"/>
                                    </TextBlock>
                                    
                                    <Border Height="1" 
                                            Background="{StaticResource BorderBrush}"
                                            Margin="0,15"/>
                                    
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="مبيعات اليوم"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextLightBrush}"/>
                                            <TextBlock FontSize="14" 
                                                       Foreground="{StaticResource SuccessBrush}"
                                                       FontWeight="SemiBold">
                                                <Run Text="+"/>
                                                <Run Text="{Binding TodaySales, StringFormat=N0}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="مصروفات اليوم"
                                                       FontSize="11"
                                                       Foreground="{StaticResource TextLightBrush}"/>
                                            <TextBlock FontSize="14" 
                                                       Foreground="{StaticResource DangerBrush}"
                                                       FontWeight="SemiBold">
                                                <Run Text="-"/>
                                                <Run Text="{Binding TodayExpenses, StringFormat=N0}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Quick Actions Section -->
        <Border Grid.Row="3" Style="{StaticResource DashboardCard}" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Text="🚀 إجراءات سريعة"
                           Style="{StaticResource SectionTitle}"
                           Margin="0,0,0,20"/>

                <UniformGrid Rows="1" Columns="3">
                    <!-- New Sale Invoice -->
                    <Border x:Name="SaleInvoiceCard"
                            Background="{StaticResource PrimaryGradientBrush}"
                            CornerRadius="16"
                            Padding="25"
                            Margin="0,0,15,0"
                            Cursor="Hand"
                            MouseLeftButtonUp="NewSaleInvoice_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.9"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.3"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Grid.Row="0" 
                                    Width="60" Height="60" 
                                    CornerRadius="15"
                                    Background="White"
                                    Opacity="0.2"
                                    HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="0" 
                                       Text="🧾" 
                                       FontSize="36"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,8,0"/>
                            
                            <TextBlock Grid.Row="1" 
                                       Text="فاتورة بيع جديدة"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,15,0,5"/>
                            
                            <TextBlock Grid.Row="2" 
                                       Text="إنشاء فاتورة مبيعات جديدة للعملاء"
                                       Foreground="White"
                                       Opacity="0.85"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- New Purchase Invoice -->
                    <Border x:Name="PurchaseInvoiceCard"
                            Background="{StaticResource InfoGradientBrush}"
                            CornerRadius="16"
                            Padding="25"
                            Margin="0,0,15,0"
                            Cursor="Hand"
                            MouseLeftButtonUp="NewPurchaseInvoice_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.9"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.3"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Grid.Row="0" 
                                    Width="60" Height="60" 
                                    CornerRadius="15"
                                    Background="White"
                                    Opacity="0.2"
                                    HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="0" 
                                       Text="📦" 
                                       FontSize="36"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,8,0"/>
                            
                            <TextBlock Grid.Row="1" 
                                       Text="فاتورة شراء جديدة"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,15,0,5"/>
                            
                            <TextBlock Grid.Row="2" 
                                       Text="إضافة بضاعة جديدة للمخزون"
                                       Foreground="White"
                                       Opacity="0.85"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- New Tailoring Order -->
                    <Border x:Name="TailoringOrderCard"
                            Background="{StaticResource SuccessGradientBrush}"
                            CornerRadius="16"
                            Padding="25"
                            Margin="0"
                            Cursor="Hand"
                            MouseLeftButtonUp="NewTailoringOrder_Click">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.9"/>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect BlurRadius="15" ShadowDepth="3" Opacity="0.3"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Grid.Row="0" 
                                    Width="60" Height="60" 
                                    CornerRadius="15"
                                    Background="White"
                                    Opacity="0.2"
                                    HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="0" 
                                       Text="✂️" 
                                       FontSize="36"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,8,0"/>
                            
                            <TextBlock Grid.Row="1" 
                                       Text="طلب فصال جديد"
                                       Foreground="White"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,15,0,5"/>
                            
                            <TextBlock Grid.Row="2" 
                                       Text="إنشاء طلب تفصيل جديد للعملاء"
                                       Foreground="White"
                                       Opacity="0.85"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </UniformGrid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
