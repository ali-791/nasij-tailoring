<UserControl x:Class="TailoringShop.WPF.Views.Pages.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Date Filter Bar -->
        <Border Grid.Row="0" Style="{StaticResource DashboardCard}" Margin="0,0,0,20" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Date Range -->
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <StackPanel Margin="0,0,15,0">
                        <TextBlock Text="من تاريخ"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,3"/>
                        <DatePicker SelectedDate="{Binding FromDate}"
                                    Width="130"
                                    Padding="8,6"
                                    FontSize="13"/>
                    </StackPanel>
                    
                    <StackPanel>
                        <TextBlock Text="إلى تاريخ"
                                   FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,0,0,3"/>
                        <DatePicker SelectedDate="{Binding ToDate}"
                                    Width="130"
                                    Padding="8,6"
                                    FontSize="13"/>
                    </StackPanel>
                </StackPanel>

                <!-- Quick Filters -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource OutlineButton}"
                            Content="اليوم"
                            Padding="12,6"
                            FontSize="11"
                            Margin="0,0,5,0"
                            Command="{Binding SetTodayCommand}"/>
                    <Button Style="{StaticResource OutlineButton}"
                            Content="هذا الأسبوع"
                            Padding="12,6"
                            FontSize="11"
                            Margin="0,0,5,0"
                            Command="{Binding SetThisWeekCommand}"/>
                    <Button Style="{StaticResource OutlineButton}"
                            Content="هذا الشهر"
                            Padding="12,6"
                            FontSize="11"
                            Margin="0,0,5,0"
                            Command="{Binding SetThisMonthCommand}"/>
                    <Button Style="{StaticResource OutlineButton}"
                            Content="هذه السنة"
                            Padding="12,6"
                            FontSize="11"
                            Command="{Binding SetThisYearCommand}"/>
                </StackPanel>

                <!-- Refresh -->
                <Button Grid.Column="3"
                        Style="{StaticResource PrimaryButton}"
                        Content="🔄 تحديث التقرير"
                        Padding="15,8"
                        VerticalAlignment="Bottom"
                        Command="{Binding RefreshCommand}"/>
            </Grid>
        </Border>

        <!-- Reports Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Loading -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="جاري تحميل التقرير..."
                               FontSize="16"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Reports -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}">
                    
                    <!-- Row 1: Sales & Expenses Summary -->
                    <UniformGrid Rows="1" Columns="4" Margin="0,0,0,20">
                        <!-- Total Sales -->
                        <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0"
                                Background="#e8f5e9">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="إجمالي المبيعات"
                                               FontSize="13"
                                               Foreground="#2e7d32"/>
                                    <TextBlock Margin="0,10,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                                <Setter Property="Foreground" Value="#388e3c"/>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding TotalSales, StringFormat=N0}"/>
                                        <Run Text=" د.ع" FontSize="12"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,5,0,0"
                                               FontSize="12"
                                               Foreground="#66bb6a">
                                        <Run Text="{Binding SalesCount}"/>
                                        <Run Text=" فاتورة"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="💰"
                                           FontSize="40"
                                           Opacity="0.2"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"/>
                            </Grid>
                        </Border>

                        <!-- Total Expenses -->
                        <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0"
                                Background="#ffebee">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="إجمالي المصروفات"
                                               FontSize="13"
                                               Foreground="#c62828"/>
                                    <TextBlock Margin="0,10,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                                <Setter Property="Foreground" Value="#d32f2f"/>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding TotalExpenses, StringFormat=N0}"/>
                                        <Run Text=" د.ع" FontSize="12"/>
                                    </TextBlock>
                                    <TextBlock Margin="0,5,0,0"
                                               FontSize="12"
                                               Foreground="#e57373">
                                        <Run Text="{Binding ExpensesCount}"/>
                                        <Run Text=" مصروف"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="💸"
                                           FontSize="40"
                                           Opacity="0.2"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"/>
                            </Grid>
                        </Border>

                        <!-- Gross Profit -->
                        <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0"
                                Background="#e3f2fd">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="إجمالي الربح"
                                               FontSize="13"
                                               Foreground="#1565c0"/>
                                    <TextBlock Margin="0,10,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                                <Setter Property="Foreground" Value="#1976d2"/>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding GrossProfit, StringFormat=N0}"/>
                                        <Run Text=" د.ع" FontSize="12"/>
                                    </TextBlock>
                                    <TextBlock Text="قبل المصروفات"
                                               Margin="0,5,0,0"
                                               FontSize="12"
                                               Foreground="#64b5f6"/>
                                </StackPanel>
                                <TextBlock Text="📊"
                                           FontSize="40"
                                           Opacity="0.2"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"/>
                            </Grid>
                        </Border>

                        <!-- Net Profit -->
                        <Border Background="#f3e5f5"
                                CornerRadius="12"
                                Padding="20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
                            </Border.Effect>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="صافي الربح"
                                               FontSize="13"
                                               Foreground="#7b1fa2"/>
                                    <TextBlock Margin="0,10,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                                <Setter Property="Foreground" Value="#8e24aa"/>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding NetProfit, StringFormat=N0}"/>
                                        <Run Text=" د.ع" FontSize="12"/>
                                    </TextBlock>
                                    <TextBlock Text="بعد المصروفات"
                                               Margin="0,5,0,0"
                                               FontSize="12"
                                               Foreground="#ba68c8"/>
                                </StackPanel>
                                <TextBlock Text="✨"
                                           FontSize="40"
                                           Opacity="0.2"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <!-- Row 2: Payment & Orders -->
                    <UniformGrid Rows="1" Columns="4" Margin="0,0,0,20">
                        <!-- Paid Amount -->
                        <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="المبالغ المحصّلة"
                                               Style="{StaticResource CardTitle}"/>
                                    <TextBlock Margin="0,10,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding TotalPaid, StringFormat=N0}"/>
                                        <Run Text=" د.ع" FontSize="12"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="✅"
                                           FontSize="35"
                                           Opacity="0.1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"/>
                            </Grid>
                        </Border>

                        <!-- Remaining Amount -->
                        <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="المبالغ المتبقية"
                                               Style="{StaticResource CardTitle}"/>
                                    <TextBlock Margin="0,10,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding TotalRemaining, StringFormat=N0}"/>
                                        <Run Text=" د.ع" FontSize="12"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="⏳"
                                           FontSize="35"
                                           Opacity="0.1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"/>
                            </Grid>
                        </Border>

                        <!-- Tailoring Orders -->
                        <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="طلبات الفصال"
                                               Style="{StaticResource CardTitle}"/>
                                    <TextBlock Text="{Binding TotalOrders}"
                                               Style="{StaticResource StatValue}"
                                               Foreground="{StaticResource PrimaryBrush}"
                                               Margin="0,10,0,0"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock FontSize="11" Foreground="{StaticResource SuccessBrush}">
                                            <Run Text="✓"/>
                                            <Run Text="{Binding CompletedOrders}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource AccentBrush}" Margin="10,0,0,0">
                                            <Run Text="⏳"/>
                                            <Run Text="{Binding PendingOrders}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="✂️"
                                           FontSize="35"
                                           Opacity="0.1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"/>
                            </Grid>
                        </Border>

                        <!-- Tailoring Revenue -->
                        <Border Style="{StaticResource DashboardCard}">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="إيرادات الفصال"
                                               Style="{StaticResource CardTitle}"/>
                                    <TextBlock Margin="0,10,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            </Style>
                                        </TextBlock.Style>
                                        <Run Text="{Binding TailoringRevenue, StringFormat=N0}"/>
                                        <Run Text=" د.ع" FontSize="12"/>
                                    </TextBlock>
                                </StackPanel>
                                <TextBlock Text="🧵"
                                           FontSize="35"
                                           Opacity="0.1"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Top"/>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <!-- Row 3: Details Tables -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Top Products -->
                        <Border Grid.Column="0" Style="{StaticResource DashboardCard}" Margin="0,0,10,0" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="🏆 أكثر المنتجات مبيعاً"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Margin="0,0,0,15"/>

                                <ItemsControl Grid.Row="1" ItemsSource="{Binding TopProducts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BackgroundBrush}"
                                                    CornerRadius="8"
                                                    Padding="12"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding ProductName}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"/>
                                                        <TextBlock FontSize="12"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Margin="0,3,0,0">
                                                            <Run Text="الكمية:"/>
                                                            <Run Text="{Binding QuantitySold, StringFormat=N0}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource SuccessBrush}">
                                                        <Run Text="{Binding TotalRevenue, StringFormat=N0}"/>
                                                        <Run Text=" د.ع" FontSize="10"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty State -->
                                <TextBlock Grid.Row="1"
                                           Text="لا توجد مبيعات في هذه الفترة"
                                           FontSize="13"
                                           Foreground="{StaticResource TextLightBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding TopProducts.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=inverse}"/>
                            </Grid>
                        </Border>

                        <!-- Expenses by Category -->
                        <Border Grid.Column="1" Style="{StaticResource DashboardCard}" Margin="10,0,0,0" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="📊 المصروفات حسب الفئة"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           Margin="0,0,0,15"/>

                                <ItemsControl Grid.Row="1" ItemsSource="{Binding ExpensesByCategory}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BackgroundBrush}"
                                                    CornerRadius="8"
                                                    Padding="12"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding CategoryName}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"/>
                                                        <TextBlock FontSize="12"
                                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                                   Margin="0,3,0,0">
                                                            <Run Text="{Binding Count}"/>
                                                            <Run Text=" مصروف"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource DangerBrush}">
                                                        <Run Text="{Binding Amount, StringFormat=N0}"/>
                                                        <Run Text=" د.ع" FontSize="10"/>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Empty State -->
                                <TextBlock Grid.Row="1"
                                           Text="لا توجد مصروفات في هذه الفترة"
                                           FontSize="13"
                                           Foreground="{StaticResource TextLightBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding ExpensesByCategory.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=inverse}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Row 4: Quick Stats -->
                    <UniformGrid Rows="1" Columns="4">
                        <!-- Total Products -->
                        <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="📦"
                                           FontSize="28"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalProducts}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>
                                <TextBlock Text="منتج"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Low Stock -->
                        <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⚠️"
                                           FontSize="28"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding LowStockCount}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource DangerBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>
                                <TextBlock Text="مخزون منخفض"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Total Customers -->
                        <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="👥"
                                           FontSize="28"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalCustomers}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>
                                <TextBlock Text="عميل"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- New Customers -->
                        <Border Style="{StaticResource DashboardCard}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🆕"
                                           FontSize="28"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding NewCustomers}"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,5,0,0"/>
                                <TextBlock Text="عميل جديد"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
