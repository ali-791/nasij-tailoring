<UserControl x:Class="TailoringShop.WPF.Views.Pages.InvoiceSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      FlowDirection="RightToLeft">

    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
        
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="#555"/>
        </Style>
        
        <Style x:Key="FieldInput" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30">
            <StackPanel MaxWidth="900">
                
                <!-- العنوان -->
                <TextBlock Text="⚙️ تخصيص الفاتورة" 
                           FontSize="24" FontWeight="Bold" 
                           Margin="0,0,0,30"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- العمود الأيمن - معلومات المتجر -->
                    <StackPanel Grid.Column="0">
                        
                        <!-- معلومات المتجر -->
                        <Border Background="White" CornerRadius="12" Padding="25" Margin="0,0,0,20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="🏪 معلومات المتجر" Style="{StaticResource SectionTitle}"/>
                                
                                <TextBlock Text="اسم المتجر" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ShopNameTextBox" Style="{StaticResource FieldInput}"/>
                                
                                <TextBlock Text="رقم الهاتف" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ShopPhoneTextBox" Style="{StaticResource FieldInput}"/>
                                
                                <TextBlock Text="العنوان" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="ShopAddressTextBox" Style="{StaticResource FieldInput}" 
                                         TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                                
                                <TextBlock Text="نص أسفل الفاتورة" Style="{StaticResource FieldLabel}"/>
                                <TextBox x:Name="FooterMessageTextBox" Style="{StaticResource FieldInput}"
                                         TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                                
                                <!-- شعار المتجر -->
                                <TextBlock Text="شعار المتجر (Logo)" Style="{StaticResource FieldLabel}"/>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" 
                                            CornerRadius="8" Height="80" Margin="0,0,10,0"
                                            Background="#F9F9F9">
                                        <Image x:Name="LogoPreview" Stretch="Uniform" Margin="10"/>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Content="📁 اختيار" Click="SelectLogo_Click"
                                                Style="{StaticResource SecondaryButton}" 
                                                Width="100" Margin="0,0,0,5"/>
                                        <Button Content="🗑️ حذف" Click="RemoveLogo_Click"
                                                Style="{StaticResource SecondaryButton}" 
                                                Width="100"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                        
                    </StackPanel>

                    <!-- العمود الأيسر - إعدادات الطباعة -->
                    <StackPanel Grid.Column="2">
                        
                        <!-- إعدادات الطباعة -->
                        <Border Background="White" CornerRadius="12" Padding="25" Margin="0,0,0,20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="🖨️ إعدادات الطباعة" Style="{StaticResource SectionTitle}"/>
                                
                                <TextBlock Text="الطابعة" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="PrinterComboBox" Margin="0,0,0,15"
                                          Style="{StaticResource ModernComboBox}"/>
                                
                                <Button Content="🔄 تحديث قائمة الطابعات" Click="RefreshPrinters_Click"
                                        Style="{StaticResource SecondaryButton}" 
                                        HorizontalAlignment="Right" Margin="0,0,0,15"/>
                                
                                <TextBlock Text="حجم الورق" Style="{StaticResource FieldLabel}"/>
                                <ComboBox x:Name="PaperSizeComboBox" Margin="0,0,0,15"
                                          Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="طابعة حرارية 58mm" Tag="Receipt58mm"/>
                                    <ComboBoxItem Content="طابعة حرارية 80mm" Tag="Receipt80mm" IsSelected="True"/>
                                    <ComboBoxItem Content="ورق A5" Tag="A5"/>
                                    <ComboBoxItem Content="ورق A4" Tag="A4"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                        
                        <!-- خيارات العرض -->
                        <Border Background="White" CornerRadius="12" Padding="25" Margin="0,0,0,20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="👁️ خيارات العرض" Style="{StaticResource SectionTitle}"/>
                                
                                <CheckBox x:Name="ShowLogoCheckBox" Content="إظهار الشعار" 
                                          IsChecked="True" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ShowDateCheckBox" Content="إظهار التاريخ" 
                                          IsChecked="True" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ShowCustomerPhoneCheckBox" Content="إظهار رقم هاتف العميل" 
                                          IsChecked="True" Margin="0,0,0,10"/>
                                <CheckBox x:Name="ShowFooterCheckBox" Content="إظهار نص أسفل الفاتورة" 
                                          IsChecked="True" Margin="0,0,0,10"/>
                                
                                <Separator Margin="0,10"/>
                                
                                <TextBlock Text="فاتورة البيع:" FontWeight="SemiBold" Margin="0,5,0,10"/>
                                <CheckBox x:Name="SaleShowDiscountCheckBox" Content="إظهار الخصم" 
                                          IsChecked="True" Margin="15,0,0,10"/>
                                
                                <TextBlock Text="فاتورة الفصال:" FontWeight="SemiBold" Margin="0,10,0,10"/>
                                <CheckBox x:Name="TailoringShowDeliveryDateCheckBox" Content="إظهار تاريخ التسليم" 
                                          IsChecked="True" Margin="15,0,0,10"/>
                                <CheckBox x:Name="TailoringShowNotesCheckBox" Content="إظهار الملاحظات" 
                                          IsChecked="True" Margin="15,0,0,10"/>
                            </StackPanel>
                        </Border>
                        
                    </StackPanel>
                </Grid>

                <!-- أزرار الحفظ -->
                <Border Background="White" CornerRadius="12" Padding="25" Margin="0,10,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" Opacity="0.1" ShadowDepth="2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="1" Content="🖨️ طباعة تجريبية" 
                                Click="TestPrint_Click"
                                Style="{StaticResource SecondaryButton}"
                                Width="150" Margin="0,0,10,0"/>
                        
                        <Button Grid.Column="2" Content="💾 حفظ الإعدادات" 
                                Click="SaveSettings_Click"
                                Style="{StaticResource PrimaryButton}"
                                Width="150"/>
                    </Grid>
                </Border>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
