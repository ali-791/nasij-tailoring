<UserControl x:Class="TailoringShop.WPF.Views.Pages.CashboxesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Stats Cards -->
        <UniformGrid Grid.Row="0" Rows="1" Columns="3" Margin="0,0,0,20">
            <!-- Total Balance -->
            <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0"
                    Background="#e8f5e9">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="إجمالي الرصيد"
                                   FontSize="14"
                                   Foreground="#2e7d32"/>
                        <TextBlock Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatValue}">
                                    <Setter Property="Foreground" Value="#388e3c"/>
                                </Style>
                            </TextBlock.Style>
                            <Run Text="{Binding TotalBalance, StringFormat=N0}"/>
                            <Run Text=" د.ع" FontSize="14"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="💰"
                               FontSize="50"
                               Opacity="0.2"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- Active Cashboxes -->
            <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="عدد الصناديق"
                                   Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding ActiveCashboxes}"
                                   Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                    <TextBlock Text="🏦"
                               FontSize="50"
                               Opacity="0.1"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <!-- Add Cashbox Button -->
            <Border Style="{StaticResource DashboardCard}" 
                    Background="{StaticResource PrimaryGradientBrush}"
                    Cursor="Hand"
                    MouseLeftButtonUp="AddCashbox_Click">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="➕"
                                   FontSize="32"
                                   HorizontalAlignment="Center"
                                   Foreground="White"/>
                        <TextBlock Text="إضافة صندوق"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Action Bar -->
        <Border Grid.Row="1" Style="{StaticResource DashboardCard}" Margin="0,0,0,20" Padding="15">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource OutlineButton}"
                            Content="🔄 تحديث"
                            Padding="15,8"
                            FontSize="13"
                            Command="{Binding RefreshCommand}"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SuccessButton}"
                            Content="💵 إيداع"
                            Padding="20,10"
                            FontSize="13"
                            Margin="0,0,10,0"
                            Command="{Binding DepositCommand}"
                            IsEnabled="{Binding SelectedCashbox, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=bool}"/>
                    
                    <Button Style="{StaticResource DangerButton}"
                            Content="💸 سحب"
                            Padding="20,10"
                            FontSize="13"
                            Command="{Binding WithdrawCommand}"
                            IsEnabled="{Binding SelectedCashbox, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=bool}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Cashboxes Cards -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <!-- Loading Indicator -->
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="جاري التحميل..."
                               FontSize="16"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Cashboxes List -->
                <ItemsControl ItemsSource="{Binding Cashboxes}"
                              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,15,15"
                                    Padding="20"
                                    Cursor="Hand"
                                    MouseLeftButtonUp="CashboxCard_Click"
                                    BorderThickness="2"
                                    BorderBrush="Transparent"
                                    Background="White"
                                    CornerRadius="12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.08"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,15">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="45" Height="45"
                                                    CornerRadius="10"
                                                    Background="{StaticResource PrimaryGradientBrush}">
                                                <TextBlock Text="🏦"
                                                           FontSize="22"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="16"
                                                           FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Type, Converter={StaticResource CashboxTypeConverter}}"
                                                           FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource IconButton}"
                                                    Content="✏️"
                                                    ToolTip="تعديل"
                                                    Width="32" Height="32"
                                                    Click="EditCashbox_Click"/>
                                            <Button Style="{StaticResource IconButton}"
                                                    Content="🗑️"
                                                    ToolTip="حذف"
                                                    Width="32" Height="32"
                                                    Click="DeleteCashbox_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Balance -->
                                    <Border Grid.Row="1" 
                                            Background="{StaticResource BackgroundBrush}"
                                            CornerRadius="10"
                                            Padding="15"
                                            Margin="0,0,0,15">
                                        <StackPanel>
                                            <TextBlock Text="الرصيد الحالي"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Margin="0,5,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="24"/>
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CurrentBalance, Converter={StaticResource IsNegativeConverter}}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                                <Run Text="{Binding CurrentBalance, StringFormat=N0}"/>
                                                <Run Text=" د.ع" FontSize="14"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>

                                    <!-- Quick Actions - Deposit & Withdrawal -->
                                    <Grid Grid.Row="2" Margin="0,5,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <Button Grid.Column="0"
                                                Style="{StaticResource SuccessButton}"
                                                Padding="15,15"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Margin="0,0,5,0"
                                                Click="Deposit_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="💵" FontSize="20" Margin="0,0,8,0"/>
                                                <TextBlock Text="إيداع" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        
                                        <Button Grid.Column="1"
                                                Style="{StaticResource DangerButton}"
                                                Padding="15,15"
                                                FontSize="14"
                                                FontWeight="Bold"
                                                Margin="5,0,0,0"
                                                Click="Withdraw_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="💸" FontSize="20" Margin="0,0,8,0"/>
                                                <TextBlock Text="سحب" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty State -->
                <StackPanel Visibility="{Binding Cashboxes.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=inverse}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="🏦"
                               FontSize="64"
                               HorizontalAlignment="Center"
                               Opacity="0.3"/>
                    <TextBlock Text="لا توجد صناديق"
                               FontSize="18"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               Margin="0,10,0,0"/>
                    <Button Style="{StaticResource PrimaryButton}"
                            Content="➕ إضافة صندوق"
                            Margin="0,20,0,0"
                            Command="{Binding AddCashboxCommand}"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
