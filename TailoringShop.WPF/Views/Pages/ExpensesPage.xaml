<UserControl x:Class="TailoringShop.WPF.Views.Pages.ExpensesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:TailoringShop.WPF.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Stats Cards -->
        <UniformGrid Grid.Row="0" Rows="1" Margin="0,0,0,20">
            <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="إجمالي المصروفات" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding TotalExpenses}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,10,0,0"/>
                    </StackPanel>
                    <TextBlock Text="💸" FontSize="40" Opacity="0.1" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="مصروفات اليوم" Style="{StaticResource CardTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{Binding TodayExpenses, StringFormat=N0}" Style="{StaticResource StatValue}"
                                       Foreground="{StaticResource DangerBrush}"/>
                            <TextBlock Text=" د.ع" Style="{StaticResource CardTitle}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="📅" FontSize="40" Opacity="0.1" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="مصروفات الشهر" Style="{StaticResource CardTitle}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{Binding MonthExpenses, StringFormat=N0}" Style="{StaticResource StatValue}"
                                       Foreground="{StaticResource WarningBrush}"/>
                            <TextBlock Text=" د.ع" Style="{StaticResource CardTitle}" VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="📊" FontSize="40" Opacity="0.1" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardCard}" Background="{StaticResource PrimaryGradientBrush}"
                    Cursor="Hand" MouseLeftButtonUp="AddExpense_Click">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="➕" FontSize="32" HorizontalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="إضافة مصروف جديد" FontSize="14" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Search and Filters -->
        <Border Grid.Row="1" Style="{StaticResource DashboardCard}" Margin="0,0,0,20" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource BackgroundBrush}" CornerRadius="8"
                        Padding="12,8" MaxWidth="400" HorizontalAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.5"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" FontSize="14" VerticalAlignment="Center" Width="280"/>
                        <TextBlock Grid.Column="1" Text="بحث بالوصف أو رقم المصروف..." FontSize="14"
                                   Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=inverse}"/>
                    </Grid>
                </Border>

                <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"
                          DisplayMemberPath="Name" Width="200" Margin="15,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Content="🔄 تحديث" Margin="0,0,10,0" Command="{Binding RefreshCommand}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="➕ مصروف جديد" Padding="20,10" Command="{Binding AddExpenseCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource DashboardCard}" Padding="0">
            <Grid>
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="جاري التحميل..." FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <DataGrid x:Name="ExpensesDataGrid"
                          ItemsSource="{Binding Expenses}"
                          SelectedItem="{Binding SelectedExpense}"
                          Style="{StaticResource ModernDataGrid}"
                          RowStyle="{StaticResource ModernDataGridRow}"
                          CellStyle="{StaticResource ModernDataGridCell}"
                          ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}"
                          RowDetailsVisibilityMode="VisibleWhenSelected"
                          MouseDoubleClick="DataGrid_MouseDoubleClick"
                          PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown">
                    
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AnimatedRowDetails}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- معلومات المصروف -->
                                    <Border Grid.Column="0" Style="{StaticResource DetailCard}">
                                        <StackPanel>
                                            <TextBlock Text="💸 معلومات المصروف" Style="{StaticResource DetailSectionHeader}"/>
                                            <TextBlock Text="رقم المصروف" Style="{StaticResource DetailLabel}"/>
                                            <TextBlock Text="{Binding ExpenseNumber}" Style="{StaticResource DetailValue}" 
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                            <TextBlock Text="الفئة" Style="{StaticResource DetailLabel}" Margin="0,10,0,4"/>
                                            <TextBlock Text="{Binding Category.Name}" Style="{StaticResource DetailValue}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- المبلغ -->
                                    <Border Grid.Column="1" Style="{StaticResource DetailCard}">
                                        <StackPanel>
                                            <TextBlock Text="💰 المبلغ" Style="{StaticResource DetailSectionHeader}"/>
                                            <TextBlock Text="قيمة المصروف" Style="{StaticResource DetailLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Amount, StringFormat=N0}" 
                                                           Style="{StaticResource DetailValue}" FontSize="24"
                                                           Foreground="{StaticResource DangerBrush}"/>
                                                <TextBlock Text=" د.ع" Foreground="{StaticResource TextLightBrush}" 
                                                           VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                                            </StackPanel>
                                            <TextBlock Text="الصندوق" Style="{StaticResource DetailLabel}" Margin="0,15,0,4"/>
                                            <TextBlock Text="{Binding Cashbox.Name}" Style="{StaticResource DetailValue}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- الوصف -->
                                    <Border Grid.Column="2" Style="{StaticResource DetailCard}">
                                        <StackPanel>
                                            <TextBlock Text="📝 الوصف" Style="{StaticResource DetailSectionHeader}"/>
                                            <TextBlock Text="تفاصيل المصروف" Style="{StaticResource DetailLabel}"/>
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource DetailValue}"
                                                       TextWrapping="Wrap" MaxWidth="250"/>
                                            <TextBlock Text="رقم المرجع" Style="{StaticResource DetailLabel}" Margin="0,10,0,4"/>
                                            <TextBlock Text="{Binding ReferenceNumber, TargetNullValue='-'}" 
                                                       Style="{StaticResource DetailValue}" Foreground="{StaticResource InfoBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- التاريخ -->
                                    <Border Grid.Column="3" Style="{StaticResource DetailCard}" Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="📅 التاريخ" Style="{StaticResource DetailSectionHeader}"/>
                                            <TextBlock Text="تاريخ المصروف" Style="{StaticResource DetailLabel}"/>
                                            <TextBlock Text="{Binding ExpenseDate, StringFormat=yyyy/MM/dd}" Style="{StaticResource DetailValue}"/>
                                            <TextBlock Text="وقت الإضافة" Style="{StaticResource DetailLabel}" Margin="0,10,0,4"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat=yyyy/MM/dd - HH:mm}" 
                                                       Style="{StaticResource DetailValue}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                    
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="▶" FontSize="10" Foreground="{StaticResource TextLightBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                        <Setter Property="Text" Value="▼"/>
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTextColumn Header="رقم المصروف" Binding="{Binding ExpenseNumber}" Width="130" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="الفئة" Binding="{Binding Category.Name}" Width="150" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="المبلغ" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource DangerBrush}">
                                        <Run Text="{Binding Amount, StringFormat=N0}"/>
                                        <Run Text=" د.ع" Foreground="{StaticResource TextLightBrush}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding ExpenseDate, StringFormat=yyyy/MM/dd}" Width="100" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="إجراءات" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Content="✏️" ToolTip="تعديل"
                                                Click="EditButton_Click" Width="35" Height="35"/>
                                        <Button Style="{StaticResource IconButton}" Content="🗑️" ToolTip="حذف"
                                                Click="DeleteButton_Click" Width="35" Height="35"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Visibility="{Binding Expenses.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=inverse}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="💸" FontSize="64" HorizontalAlignment="Center" Opacity="0.3"/>
                    <TextBlock Text="لا يوجد مصروفات" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="إضافة مصروف جديد" Margin="0,20,0,0"
                            Command="{Binding AddExpenseCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Pagination -->
        <controls:PaginationControl Grid.Row="3"
                                    CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
                                    TotalPages="{Binding TotalPages}"
                                    TotalRecords="{Binding TotalRecords}"
                                    PageSize="{Binding PageSize, Mode=TwoWay}"
                                    PageChangedCommand="{Binding PageChangedCommand}"/>
    </Grid>
</UserControl>
