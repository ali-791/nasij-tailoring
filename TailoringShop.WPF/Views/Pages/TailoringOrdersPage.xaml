<UserControl x:Class="TailoringShop.WPF.Views.Pages.TailoringOrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:TailoringShop.WPF.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Stats Cards -->
        <UniformGrid Grid.Row="0" Rows="1" Margin="0,0,0,20">
            <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="إجمالي الطلبات" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding TotalOrders}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,10,0,0"/>
                    </StackPanel>
                    <TextBlock Text="📋" FontSize="40" Opacity="0.1" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="قيد العمل" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding InProgressOrders}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource WarningBrush}" Margin="0,10,0,0"/>
                    </StackPanel>
                    <TextBlock Text="⏳" FontSize="40" Opacity="0.1" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="جاهزة للتسليم" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding ReadyOrders}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource SuccessBrush}" Margin="0,10,0,0"/>
                    </StackPanel>
                    <TextBlock Text="✓" FontSize="40" Opacity="0.1" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardCard}" Background="{StaticResource PrimaryGradientBrush}"
                    Cursor="Hand" MouseLeftButtonUp="AddOrder_Click">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="➕" FontSize="32" HorizontalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="طلب فصال جديد" FontSize="14" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Search and Filters -->
        <Border Grid.Row="1" Style="{StaticResource DashboardCard}" Margin="0,0,0,20" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource BackgroundBrush}" CornerRadius="8"
                        Padding="12,8" MaxWidth="400" HorizontalAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.5"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" FontSize="14" VerticalAlignment="Center" Width="280"/>
                        <TextBlock Grid.Column="1" Text="بحث برقم الطلب أو اسم العميل..." FontSize="14"
                                   Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=inverse}"/>
                    </Grid>
                </Border>

                <ComboBox Grid.Column="1" ItemsSource="{Binding StatusList}" SelectedItem="{Binding SelectedStatus}"
                          Width="180" Margin="15,0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}" Content="🔄 تحديث" Margin="0,0,10,0" Command="{Binding RefreshCommand}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="➕ طلب جديد" Padding="20,10" Command="{Binding AddOrderCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource DashboardCard}" Padding="0">
            <Grid>
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="جاري التحميل..." FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <DataGrid x:Name="OrdersDataGrid"
                          ItemsSource="{Binding Orders}"
                          SelectedItem="{Binding SelectedOrder}"
                          Style="{StaticResource ModernDataGrid}"
                          RowStyle="{StaticResource ModernDataGridRow}"
                          CellStyle="{StaticResource ModernDataGridCell}"
                          ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}"
                          RowDetailsVisibilityMode="VisibleWhenSelected"
                          MouseDoubleClick="DataGrid_MouseDoubleClick"
                          PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown">
                    
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AnimatedRowDetails}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- معلومات الطلب -->
                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DetailCard}">
                                        <StackPanel>
                                            <TextBlock Text="📋 معلومات الطلب" Style="{StaticResource DetailSectionHeader}"/>
                                            <TextBlock Text="رقم الطلب" Style="{StaticResource DetailLabel}"/>
                                            <TextBlock Text="{Binding OrderNumber}" Style="{StaticResource DetailValue}" 
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                            <TextBlock Text="العميل" Style="{StaticResource DetailLabel}" Margin="0,10,0,4"/>
                                            <TextBlock Text="{Binding Customer.FullName}" Style="{StaticResource DetailValue}"/>
                                            <TextBlock Text="رقم الهاتف" Style="{StaticResource DetailLabel}" Margin="0,10,0,4"/>
                                            <TextBlock Text="{Binding Customer.Phone, TargetNullValue='-'}" Style="{StaticResource DetailValue}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- المبالغ -->
                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DetailCard}">
                                        <StackPanel>
                                            <TextBlock Text="💰 المبالغ" Style="{StaticResource DetailSectionHeader}"/>
                                            <TextBlock Text="المبلغ الكلي" Style="{StaticResource DetailLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding TotalAmount, StringFormat=N0}" 
                                                           Style="{StaticResource DetailValue}" Foreground="{StaticResource InfoBrush}"/>
                                                <TextBlock Text=" د.ع" Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                            </StackPanel>
                                            <TextBlock Text="العربون المدفوع" Style="{StaticResource DetailLabel}" Margin="0,10,0,4"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DepositAmount, StringFormat=N0}" Style="{StaticResource DetailValueCurrency}"/>
                                                <TextBlock Text=" د.ع" Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                            </StackPanel>
                                            <TextBlock Text="المتبقي" Style="{StaticResource DetailLabel}" Margin="0,10,0,4"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding RemainingAmount, StringFormat=N0}" 
                                                           Style="{StaticResource DetailValue}" Foreground="{StaticResource DangerBrush}"/>
                                                <TextBlock Text=" د.ع" Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- التواريخ والحالة -->
                                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource DetailCard}" Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="📅 التواريخ" Style="{StaticResource DetailSectionHeader}"/>
                                            <TextBlock Text="تاريخ الطلب" Style="{StaticResource DetailLabel}"/>
                                            <TextBlock Text="{Binding OrderDate, StringFormat=yyyy/MM/dd}" Style="{StaticResource DetailValue}"/>
                                            <TextBlock Text="موعد التسليم" Style="{StaticResource DetailLabel}" Margin="0,10,0,4"/>
                                            <TextBlock Text="{Binding DeliveryDate, StringFormat=yyyy/MM/dd}" 
                                                       Style="{StaticResource DetailValue}" Foreground="{StaticResource WarningBrush}"/>
                                            <TextBlock Text="الحالة" Style="{StaticResource DetailLabel}" Margin="0,10,0,4"/>
                                            <Border CornerRadius="12" Padding="12,6" HorizontalAlignment="Right"
                                                    Background="{Binding Status, Converter={StaticResource OrderStatusToBackgroundConverter}}">
                                                <TextBlock Text="{Binding Status, Converter={StaticResource OrderStatusToTextConverter}}"
                                                           Foreground="{Binding Status, Converter={StaticResource OrderStatusToForegroundConverter}}"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- قائمة البنود -->
                                    <Border Grid.Row="1" Grid.ColumnSpan="3" Background="White" CornerRadius="8" 
                                            Padding="15" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="📝 بنود الطلب" Style="{StaticResource DetailSectionHeader}"/>
                                            <DataGrid ItemsSource="{Binding Items}" 
                                                      Style="{StaticResource NestedDataGrid}"
                                                      ColumnHeaderStyle="{StaticResource NestedDataGridColumnHeader}"
                                                      CellStyle="{StaticResource NestedDataGridCell}"
                                                      AutoGenerateColumns="False" IsReadOnly="True">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Header="اسم القطعة" Binding="{Binding ItemName}" Width="200" MinWidth="150">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="TextAlignment" Value="Right"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Padding" Value="8,0"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="*" MinWidth="150">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="TextAlignment" Value="Right"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Padding" Value="8,0"/>
                                                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity}" Width="80" MinWidth="60">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="TextAlignment" Value="Center"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, StringFormat={}{0:N0} د.ع}" Width="120" MinWidth="100">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="TextAlignment" Value="Right"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Padding" Value="8,0"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                    <DataGridTextColumn Header="المجموع" Binding="{Binding Total, StringFormat={}{0:N0} د.ع}" Width="120" MinWidth="100">
                                                        <DataGridTextColumn.ElementStyle>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="TextAlignment" Value="Right"/>
                                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                                                <Setter Property="Padding" Value="8,0"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                            </Style>
                                                        </DataGridTextColumn.ElementStyle>
                                                    </DataGridTextColumn>
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                    
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="▶" FontSize="10" Foreground="{StaticResource TextLightBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                        <Setter Property="Text" Value="▼"/>
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTextColumn Header="رقم الطلب" Binding="{Binding OrderNumber}" Width="120" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="العميل" Binding="{Binding Customer.FullName}" Width="*" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="المبلغ" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding TotalAmount, StringFormat=N0}"/>
                                        <Run Text=" د.ع" Foreground="{StaticResource TextLightBrush}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="موعد التسليم" Binding="{Binding DeliveryDate, StringFormat=yyyy/MM/dd}" Width="110" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="الحالة" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left"
                                            Background="{Binding Status, Converter={StaticResource OrderStatusToBackgroundConverter}}">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource OrderStatusToTextConverter}}"
                                                   FontSize="12" Foreground="{Binding Status, Converter={StaticResource OrderStatusToForegroundConverter}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="إجراءات" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Content="▶" ToolTip="بدء العمل"
                                                Click="StartButton_Click" Width="32" Height="32" FontSize="10"/>
                                        <Button Style="{StaticResource IconButton}" Content="✓" ToolTip="جاهز"
                                                Click="ReadyButton_Click" Width="32" Height="32"/>
                                        <Button Style="{StaticResource IconButton}" Content="📦" ToolTip="تسليم"
                                                Click="DeliverButton_Click" Width="32" Height="32"/>
                                        <Button Style="{StaticResource IconButton}" Content="✏️" ToolTip="تعديل"
                                                Click="EditButton_Click" Width="32" Height="32"/>
                                        <Button Style="{StaticResource IconButton}" Content="✕" ToolTip="إلغاء"
                                                Click="CancelButton_Click" Width="32" Height="32"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Visibility="{Binding Orders.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=inverse}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="📋" FontSize="64" HorizontalAlignment="Center" Opacity="0.3"/>
                    <TextBlock Text="لا يوجد طلبات" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="إضافة طلب جديد" Margin="0,20,0,0"
                            Command="{Binding AddOrderCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Pagination -->
        <controls:PaginationControl Grid.Row="3"
                                    CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
                                    TotalPages="{Binding TotalPages}"
                                    TotalRecords="{Binding TotalRecords}"
                                    PageSize="{Binding PageSize, Mode=TwoWay}"
                                    PageChangedCommand="{Binding PageChangedCommand}"/>
    </Grid>
</UserControl>
