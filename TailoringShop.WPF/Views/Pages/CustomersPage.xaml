<UserControl x:Class="TailoringShop.WPF.Views.Pages.CustomersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:TailoringShop.WPF.Views.Controls"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1200">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Stats Cards -->
        <UniformGrid Grid.Row="0" Rows="1" Margin="0,0,0,20">
            <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="إجمالي العملاء" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding TotalCustomers}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource PrimaryBrush}" Margin="0,10,0,0"/>
                    </StackPanel>
                    <TextBlock Text="👥" FontSize="40" Opacity="0.1" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="العملاء النشطين" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding ActiveCustomers}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource SuccessBrush}" Margin="0,10,0,0"/>
                    </StackPanel>
                    <TextBlock Text="✓" FontSize="40" Opacity="0.1" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="نتائج البحث" Style="{StaticResource CardTitle}"/>
                        <TextBlock Text="{Binding Customers.Count}" Style="{StaticResource StatValue}"
                                   Foreground="{StaticResource InfoBrush}" Margin="0,10,0,0"/>
                    </StackPanel>
                    <TextBlock Text="🔍" FontSize="40" Opacity="0.1" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource DashboardCard}" Background="{StaticResource PrimaryGradientBrush}"
                    Cursor="Hand" x:Name="AddCustomerCard" MouseLeftButtonUp="AddCustomer_Click">
                <Grid>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="➕" FontSize="32" HorizontalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="إضافة عميل جديد" FontSize="14" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Search Bar -->
        <Border Grid.Row="1" Style="{StaticResource DashboardCard}" Margin="0,0,0,20" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource BackgroundBrush}" CornerRadius="8"
                        Padding="12,8" MaxWidth="400" HorizontalAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.5"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" FontSize="14" VerticalAlignment="Center" Width="280"/>
                        <TextBlock Grid.Column="1" Text="بحث بالاسم أو رقم الهاتف..." FontSize="14"
                                   Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding SearchText, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=inverse}"/>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="✕" FontSize="12" Width="24" Height="24"
                                Visibility="{Binding SearchText, Converter={StaticResource StringToVisibilityConverter}}"
                                Command="{Binding RefreshCommand}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Content="🔄 تحديث" Margin="0,0,10,0" Command="{Binding RefreshCommand}"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="➕ إضافة عميل" Padding="20,10" Command="{Binding AddCustomerCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource DashboardCard}" Padding="0">
            <Grid>
                <StackPanel Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="جاري التحميل..." FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <DataGrid x:Name="CustomersDataGrid"
                          ItemsSource="{Binding Customers}"
                          SelectedItem="{Binding SelectedCustomer}"
                          Style="{StaticResource ModernDataGrid}"
                          RowStyle="{StaticResource ModernDataGridRow}"
                          CellStyle="{StaticResource ModernDataGridCell}"
                          ColumnHeaderStyle="{StaticResource ModernDataGridColumnHeader}"
                          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=inverse}"
                          RowDetailsVisibilityMode="VisibleWhenSelected"
                          MouseDoubleClick="DataGrid_MouseDoubleClick"
                          PreviewMouseLeftButtonDown="DataGrid_PreviewMouseLeftButtonDown">
                    
                    <DataGrid.RowDetailsTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource AnimatedRowDetails}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource DetailCard}">
                                        <StackPanel>
                                            <TextBlock Text="👤 معلومات العميل" Style="{StaticResource DetailSectionHeader}"/>
                                            <TextBlock Text="الاسم الكامل" Style="{StaticResource DetailLabel}"/>
                                            <TextBlock Text="{Binding FullName}" Style="{StaticResource DetailValue}"/>
                                            <TextBlock Text="رقم الهاتف" Style="{StaticResource DetailLabel}" Margin="0,10,0,4"/>
                                            <TextBlock Text="{Binding Phone, TargetNullValue='-'}" Style="{StaticResource DetailValue}" 
                                                       Foreground="{StaticResource PrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Style="{StaticResource DetailCard}">
                                        <StackPanel>
                                            <TextBlock Text="💰 المعلومات المالية" Style="{StaticResource DetailSectionHeader}"/>
                                            <TextBlock Text="إجمالي المشتريات" Style="{StaticResource DetailLabel}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding TotalPurchases, StringFormat=N0}" Style="{StaticResource DetailValueCurrency}"/>
                                                <TextBlock Text=" د.ع" Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                                            </StackPanel>
                                            <TextBlock Text="عدد الطلبات" Style="{StaticResource DetailLabel}" Margin="0,10,0,4"/>
                                            <TextBlock Text="{Binding TotalOrders}" Style="{StaticResource DetailValue}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource DetailCard}">
                                        <StackPanel>
                                            <TextBlock Text="📊 الحالة" Style="{StaticResource DetailSectionHeader}"/>
                                            <TextBlock Text="حالة الحساب" Style="{StaticResource DetailLabel}"/>
                                            <Border CornerRadius="12" Padding="12,6" HorizontalAlignment="Right"
                                                    Background="{Binding IsActive, Converter={StaticResource BoolToBackgroundConverter}}">
                                                <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}"
                                                           Foreground="{Binding IsActive, Converter={StaticResource BoolToForegroundConverter}}"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="3" Style="{StaticResource DetailCard}" Margin="0">
                                        <StackPanel>
                                            <TextBlock Text="📅 التواريخ" Style="{StaticResource DetailSectionHeader}"/>
                                            <TextBlock Text="تاريخ التسجيل" Style="{StaticResource DetailLabel}"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat=yyyy/MM/dd - HH:mm}" Style="{StaticResource DetailValue}"/>
                                            <TextBlock Text="آخر تحديث" Style="{StaticResource DetailLabel}" Margin="0,10,0,4"/>
                                            <TextBlock Text="{Binding UpdatedAt, StringFormat=yyyy/MM/dd - HH:mm, TargetNullValue='-'}" Style="{StaticResource DetailValue}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </DataGrid.RowDetailsTemplate>
                    
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="▶" FontSize="10" Foreground="{StaticResource TextLightBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=DataGridRow}}" Value="True">
                                                        <Setter Property="Text" Value="▼"/>
                                                        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="60" IsReadOnly="True"/>
                        <DataGridTextColumn Header="اسم العميل" Binding="{Binding FullName}" Width="*" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="رقم الهاتف" Binding="{Binding Phone}" Width="150" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="إجمالي المشتريات" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center">
                                        <Run Text="{Binding TotalPurchases, StringFormat=N0}"/>
                                        <Run Text=" د.ع" Foreground="{StaticResource TextLightBrush}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="عدد الطلبات" Binding="{Binding TotalOrders}" Width="100" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="الحالة" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="10,4" HorizontalAlignment="Left"
                                            Background="{Binding IsActive, Converter={StaticResource BoolToBackgroundConverter}}">
                                        <TextBlock Text="{Binding IsActive, Converter={StaticResource BoolToStatusConverter}}"
                                                   FontSize="12" Foreground="{Binding IsActive, Converter={StaticResource BoolToForegroundConverter}}"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="إجراءات" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Content="✏️" ToolTip="تعديل"
                                                Click="EditButton_Click" Width="35" Height="35"/>
                                        <Button Style="{StaticResource IconButton}" Content="🗑️" ToolTip="حذف"
                                                Click="DeleteButton_Click" Width="35" Height="35"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Visibility="{Binding Customers.Count, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=inverse}"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="👥" FontSize="64" HorizontalAlignment="Center" Opacity="0.3"/>
                    <TextBlock Text="لا يوجد عملاء" FontSize="18" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="إضافة أول عميل" Margin="0,20,0,0"
                            Command="{Binding AddCustomerCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Pagination -->
        <controls:PaginationControl Grid.Row="3"
                                    CurrentPage="{Binding CurrentPage, Mode=TwoWay}"
                                    TotalPages="{Binding TotalPages}"
                                    TotalRecords="{Binding TotalRecords}"
                                    PageSize="{Binding PageSize, Mode=TwoWay}"
                                    PageChangedCommand="{Binding PageChangedCommand}"/>
    </Grid>
</UserControl>
