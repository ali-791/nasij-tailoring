<UserControl x:Class="TailoringShop.WPF.Views.Pages.UsersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1200">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Stats Cards -->
        <UniformGrid Grid.Row="0" Rows="1" Columns="4" Margin="0,0,0,20">
            <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0" Background="#e3f2fd">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="إجمالي المستخدمين" FontSize="14" Foreground="#1565c0"/>
                        <TextBlock x:Name="TotalUsersText" Text="0" Style="{StaticResource StatValue}" Foreground="#1976d2" Margin="0,10,0,0"/>
                    </StackPanel>
                    <TextBlock Text="👥" FontSize="50" Opacity="0.2" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0" Background="#e8f5e9">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="المستخدمين النشطين" FontSize="14" Foreground="#2e7d32"/>
                        <TextBlock x:Name="ActiveUsersText" Text="0" Style="{StaticResource StatValue}" Foreground="#388e3c" Margin="0,10,0,0"/>
                    </StackPanel>
                    <TextBlock Text="✅" FontSize="50" Opacity="0.2" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource DashboardCard}" Margin="0,0,15,0" Background="#fff3e0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="المدراء" FontSize="14" Foreground="#e65100"/>
                        <TextBlock x:Name="AdminsCountText" Text="0" Style="{StaticResource StatValue}" Foreground="#f57c00" Margin="0,10,0,0"/>
                    </StackPanel>
                    <TextBlock Text="👑" FontSize="50" Opacity="0.2" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>
            <Border Style="{StaticResource DashboardCard}" Background="#f3e5f5">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="الأدوار" FontSize="14" Foreground="#7b1fa2"/>
                        <TextBlock x:Name="RolesCountText" Text="0" Style="{StaticResource StatValue}" Foreground="#8e24aa" Margin="0,10,0,0"/>
                    </StackPanel>
                    <TextBlock Text="🔐" FontSize="50" Opacity="0.2" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource DashboardCard}" Padding="15" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Border Grid.Column="0" Background="{StaticResource BackgroundBrush}" CornerRadius="8"
                        Padding="12,8" MaxWidth="400" HorizontalAlignment="Left">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.5"/>
                        <TextBox x:Name="SearchTextBox" Grid.Column="1"
                                 Background="Transparent" BorderThickness="0" FontSize="14" 
                                 VerticalAlignment="Center" Width="300"
                                 TextChanged="SearchTextBox_TextChanged"/>
                        <TextBlock Grid.Column="1" Text="بحث بالاسم أو اسم المستخدم..." FontSize="14"
                                   Foreground="{StaticResource TextLightBrush}" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Visibility="{Binding Text, ElementName=SearchTextBox, Converter={StaticResource StringToVisibilityConverter}, ConverterParameter=inverse}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="ManageRolesButton" Style="{StaticResource AccentButton}"
                            Content="🔐 إدارة الأدوار" Margin="0,0,10,0" Padding="20,10" Click="ManageRoles_Click"/>
                    <Button x:Name="RefreshButton" Style="{StaticResource SecondaryButton}"
                            Content="🔄 تحديث" Margin="0,0,10,0" Padding="20,10" Click="Refresh_Click"/>
                    <Button x:Name="AddUserButton" Style="{StaticResource PrimaryButton}"
                            Content="➕ إضافة مستخدم" Padding="20,10" Click="AddUser_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Users DataGrid -->
        <Border Grid.Row="2" Style="{StaticResource DashboardCard}" Padding="0">
            <Grid>
                <DataGrid x:Name="UsersDataGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent"
                          RowBackground="White" AlternatingRowBackground="#fafafa"
                          SelectionMode="Single" SelectionUnit="FullRow">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="المستخدم" Width="*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="10,8">
                                        <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource PrimaryGradientBrush}">
                                            <TextBlock Text="👤" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" FontSize="14"/>
                                            <TextBlock Text="{Binding Username}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="الدور" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#e3f2fd" CornerRadius="12" Padding="12,6" Margin="5" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding RoleDisplayName}" FontSize="12" Foreground="#1565c0" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="الصلاحيات" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="10,0">
                                        <TextBlock Text="{Binding PermissionsCount}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text=" صلاحية" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="الحالة" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="12,6" Margin="5" HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#ffebee"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Background" Value="#e8f5e9"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="معطل"/>
                                                    <Setter Property="Foreground" Value="#c62828"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Text" Value="نشط"/>
                                                            <Setter Property="Foreground" Value="#2e7d32"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="آخر دخول" Binding="{Binding LastLoginDisplay}" Width="140"/>
                        <DataGridTemplateColumn Header="الإجراءات" Width="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <Button Style="{StaticResource IconButton}" Content="✏️" ToolTip="تعديل" Width="35" Height="35" Click="EditUser_Click"/>
                                        <Button Style="{StaticResource IconButton}" Content="🔑" ToolTip="إعادة تعيين كلمة المرور" Width="35" Height="35" Click="ResetPassword_Click"/>
                                        <Button Style="{StaticResource IconButton}" Content="🔄" ToolTip="تفعيل/تعطيل" Width="35" Height="35" Click="ToggleStatus_Click"/>
                                        <Button Style="{StaticResource IconButton}" Content="🗑️" ToolTip="حذف" Width="35" Height="35" Click="DeleteUser_Click"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border x:Name="LoadingOverlay" Background="#80FFFFFF" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="⏳" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="جاري التحميل..." FontSize="16" Margin="0,10,0,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
