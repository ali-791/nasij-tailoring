<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Card Style -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20" 
                                  ShadowDepth="2" 
                                  Direction="270" 
                                  Color="#000000" 
                                  Opacity="0.08"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Stat Card Style -->
    <Style x:Key="StatCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="MinWidth" Value="200"/>
        <Setter Property="MinHeight" Value="100"/>
    </Style>

    <!-- Dashboard Card Style -->
    <Style x:Key="DashboardCard" TargetType="Border">
        <Setter Property="Background" Value="White"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="30" 
                                  ShadowDepth="3" 
                                  Direction="270" 
                                  Color="#000000" 
                                  Opacity="0.06"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Colored Stat Card -->
    <Style x:Key="PrimaryStatCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20" 
                                  ShadowDepth="4" 
                                  Direction="270" 
                                  Color="#667eea" 
                                  Opacity="0.3"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SuccessStatCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SuccessBrush}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20" 
                                  ShadowDepth="4" 
                                  Direction="270" 
                                  Color="#00b894" 
                                  Opacity="0.3"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WarningStatCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WarningBrush}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

    <Style x:Key="DangerStatCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="20"/>
    </Style>

</ResourceDictionary>
