<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:TailoringShop.WPF.ViewModels"
                    xmlns:pages="clr-namespace:TailoringShop.WPF.Views.Pages">

    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
        <pages:DashboardPage/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
        <pages:CustomersPage/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
        <pages:ProductsPage/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:TailoringOrdersViewModel}">
        <pages:TailoringOrdersPage/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:InvoicesViewModel}">
        <pages:InvoicesPage/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ExpensesViewModel}">
        <pages:ExpensesPage/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CashboxesViewModel}">
        <pages:CashboxesPage/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
        <pages:ReportsPage/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <pages:SettingsPage/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:UsersViewModel}">
        <pages:UsersPage/>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:InvoiceSettingsViewModel}">
        <pages:InvoiceSettingsPage/>
    </DataTemplate>

</ResourceDictionary>
