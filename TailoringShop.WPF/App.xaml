<Application x:Class="TailoringShop.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:TailoringShop.WPF.Converters"
             xmlns:vm="clr-namespace:TailoringShop.WPF.ViewModels"
             xmlns:pages="clr-namespace:TailoringShop.WPF.Views.Pages"
             StartupUri="Views/Windows/LoginWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml"/>
                <ResourceDictionary Source="Resources/Styles/Buttons.xaml"/>
                <ResourceDictionary Source="Resources/Styles/TextBoxes.xaml"/>
                <ResourceDictionary Source="Resources/Styles/Cards.xaml"/>
                <ResourceDictionary Source="Resources/Styles/DataGrid.xaml"/>
                <ResourceDictionary Source="Resources/Styles/Common.xaml"/>
                <ResourceDictionary Source="Resources/Styles/RowDetailsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Converters -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
            <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <converters:DecimalToCurrencyConverter x:Key="DecimalToCurrencyConverter"/>
            <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
            <converters:StatusToTextConverter x:Key="StatusToTextConverter"/>
            <converters:BoolToStatusConverter x:Key="BoolToStatusConverter"/>
            <converters:BoolToBackgroundConverter x:Key="BoolToBackgroundConverter"/>
            <converters:BoolToForegroundConverter x:Key="BoolToForegroundConverter"/>
            <converters:InverseStringToVisibilityConverter x:Key="InverseStringToVisibilityConverter"/>
            <converters:StockQuantityConverter x:Key="StockQuantityConverter"/>
            <converters:StockToBackgroundConverter x:Key="StockToBackgroundConverter"/>
            <converters:StockToForegroundConverter x:Key="StockToForegroundConverter"/>
            <converters:OrderStatusToTextConverter x:Key="OrderStatusToTextConverter"/>
            <converters:OrderStatusToBackgroundConverter x:Key="OrderStatusToBackgroundConverter"/>
            <converters:OrderStatusToForegroundConverter x:Key="OrderStatusToForegroundConverter"/>
            <converters:InvoiceTypeToTextConverter x:Key="InvoiceTypeToTextConverter"/>
            <converters:InvoiceTypeToBackgroundConverter x:Key="InvoiceTypeToBackgroundConverter"/>
            <converters:InvoiceTypeToForegroundConverter x:Key="InvoiceTypeToForegroundConverter"/>
            <converters:PaymentStatusToTextConverter x:Key="PaymentStatusToTextConverter"/>
            <converters:PaymentStatusToBackgroundConverter x:Key="PaymentStatusToBackgroundConverter"/>
            <converters:PaymentStatusToForegroundConverter x:Key="PaymentStatusToForegroundConverter"/>
            <converters:CustomerSupplierConverter x:Key="CustomerSupplierConverter"/>
            <converters:CashboxTypeConverter x:Key="CashboxTypeConverter"/>
            <converters:IsNegativeConverter x:Key="IsNegativeConverter"/>
            <converters:PermissionToVisibilityConverter x:Key="PermissionToVisibilityConverter"/>
            <converters:PermissionToBoolConverter x:Key="PermissionToBoolConverter"/>
            
            <!-- DataTemplates for ViewModels -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <pages:DashboardPage/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
                <pages:CustomersPage/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
                <pages:ProductsPage/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:TailoringOrdersViewModel}">
                <pages:TailoringOrdersPage/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:InvoicesViewModel}">
                <pages:InvoicesPage/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:ExpensesViewModel}">
                <pages:ExpensesPage/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:CashboxesViewModel}">
                <pages:CashboxesPage/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:ReportsViewModel}">
                <pages:ReportsPage/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <pages:SettingsPage/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:UsersViewModel}">
                <pages:UsersPage/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:InvoiceSettingsViewModel}">
                <pages:InvoiceSettingsPage/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
