    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>TailoringShop.WPF</RootNamespace>
    <AssemblyName>TailoringShop</AssemblyName>
